# The owner's own systemd user unit for the Director on Linux (see ../director-restart.md).
# Linux is the one platform where the product installs no launcher, so nothing else brings a crashed
# Director back. On Windows and macOS the installed launcher does it; do not use this file there.
#
# Copy to ~/.config/systemd/user/devthrottle-director.service, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now devthrottle-director.service
# %h is systemd's own word for the account's home folder and %U its user number, so nothing here names a user.

[Unit]
Description=DevThrottle Director
# The Director is a desktop window: start it with the desktop, stop it when the desktop ends.
PartOf=graphical-session.target
After=graphical-session.target
# Give up after 5 starts in 10 minutes, so a Director that crashes at once does not spin.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
# Do not start a second Director beside one that is already running - one opened from the app menu, say.
# "One" is ANY process named cc-director owned by this account: a named instance, a development build and the
# short-lived update relauncher all count, and while one runs the installed Director is not started.
# Off Windows a second copy cannot bring the first one's window forward; it shows "already running" and
# exits with 1, which this unit would read as a crash and retry. pgrep finds a running cc-director owned by
# this account and the "!" turns that into exit 1, which makes systemd SKIP the start: not a failure, and
# not restarted. Every restart runs this check again. Needs systemd 243 or later and pgrep (procps).
ExecCondition=/bin/sh -c '! pgrep -u %U -x cc-director'
ExecStart=%h/.local/share/cc-director/app/cc-director
# A user unit gets the user manager's short search path, not the desktop's. The Director finds the agents it
# runs (Claude Code, Codex, Gemini) on the search path, so the folders they are usually installed in are put
# back here. Add any other folder an agent on this machine is installed in.
Environment=PATH=%h/.local/bin:%h/.claude/local:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
# Start it again only when it did not end on purpose: a non-zero exit code, or killed by a signal other
# than the four systemd counts as clean (SIGHUP, SIGINT, SIGTERM, SIGPIPE). An out-of-memory kill is a
# SIGKILL and is restarted. A deliberate quit exits with 0 and is left alone.
Restart=on-failure
RestartSec=10
# A .NET program that is asked to stop with SIGTERM can report 143 (128 + 15). That is a stop on
# purpose too - logging out, or "systemctl --user stop" - so it counts as clean.
SuccessExitStatus=143
# When the Director's own process exits, kill only that process. The default (control-group) would also
# kill every agent session it started, and the updated build an update hands over to.
KillMode=process

[Install]
WantedBy=graphical-session.target
