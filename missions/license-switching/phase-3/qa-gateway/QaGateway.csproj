<Project Sdk="Microsoft.NET.Sdk">

  <!-- The License Switching mission, phase 3: a QA program, not a product and not a gate test. It is in no solution
       and no test list; qa_run.py beside it runs it. It starts a real Gateway on a real loopback port on purpose -
       the Licenses page is run against it - which is exactly why it is not a test in a gate suite. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>CcDirector.LicenseQa</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\CcDirector.Gateway\CcDirector.Gateway.csproj" />
    <ProjectReference Include="..\..\..\..\src\CcDirector.Gateway.Contracts\CcDirector.Gateway.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\src\CcDirector.Core\CcDirector.Core.csproj" />
  </ItemGroup>

  <!-- A Director on the Gateway's real tunnel, for the sign-in routes: they refuse a machine whose Director is not
       connected. It is the stand-in the Gateway's own host tests use, compiled here from their source so that there
       is one of it; it runs no Claude command and holds no sign-in. The two packages are the tunnel's client. -->
  <ItemGroup>
    <Compile Include="..\..\..\..\src\CcDirector.Gateway.Tests\FakeTunnelDirector.cs" Link="FakeTunnelDirector.cs" />
    <Compile Include="..\..\..\..\src\CcDirector.Gateway.Tests\DeadPortReservation.cs" Link="DeadPortReservation.cs" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.9" />
  </ItemGroup>

</Project>
