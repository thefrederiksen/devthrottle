<Project Sdk="Microsoft.NET.Sdk">

  <!-- The License Switching mission, phase 4: a proof program, not a product and not a gate test. It is in no
       solution and no test list; it is run by hand, as README.md beside it says. It starts real processes on
       purpose - that is the thing it proves - which is exactly why it is not a test in a gate suite. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>CcDirector.LicenseProof</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\CcDirector.Core\CcDirector.Core.csproj" />
  </ItemGroup>

</Project>
