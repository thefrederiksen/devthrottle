<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for cc-rule-hook, the Session Rules hook evaluator. Every test here is in-process and uses a
       scratch folder, an injected clock and an injected random source: no real process, no sleep, no
       real time. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CcDirector.RuleHook\CcDirector.RuleHook.csproj" />
    <!-- For the cross-piece contract test ONLY: the Director's writer of the rules file and its paths, read
         against the hook's reader. The hook itself references nothing (ruling P11); its tests may. -->
    <ProjectReference Include="..\CcDirector.Core\CcDirector.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
