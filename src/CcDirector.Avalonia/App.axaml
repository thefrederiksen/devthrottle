<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CcDirector.Avalonia.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <!-- App-wide policy: scrollbars are controls, not hover-revealed decoration.
             Keep the bar from fading out when the pointer leaves. -->
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>

        <!-- The button policy - label centring and the hover colour. In its own file because the
             headless tests include the same one; see Styles/ButtonStyles.axaml. -->
        <StyleInclude Source="avares://cc-director/Styles/ButtonStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <!-- Draw the scrollbar thumb at full thickness always, never a thin
             hover-only sliver. The Fluent theme collapses the thumb to a hairline
             by putting a scaleX(0.125)/scaleY(0.125) RenderTransform DIRECTLY on the
             thumb in its template (a local value the IsExpanded hover state clears).
             A style setter cannot beat a local value, so a "RenderTransform=none"
             style on the thumb does nothing - override the resource that local value
             resolves to instead. This is what actually fixes the collapsed bar; the
             earlier style-based attempt (#1422) silently stopped working when Avalonia
             moved the transform onto the thumb as a local value (11.3). -->
        <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">none</TransformOperations>
        <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">none</TransformOperations>

        <SolidColorBrush x:Key="PanelBackground" Color="#1E1E1E" />
        <SolidColorBrush x:Key="SidebarBackground" Color="#252526" />
        <SolidColorBrush x:Key="ButtonBackground" Color="#3C3C3C" />
        <SolidColorBrush x:Key="ButtonHover" Color="#505050" />
        <SolidColorBrush x:Key="TextForeground" Color="#CCCCCC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
        <SolidColorBrush x:Key="SelectedItemBrush" Color="#094771" />
        <!-- The Mission button (Missions First-Class mission): indigo for a Mission, a yellow outline for none. Both the
             session tab bar and the toolbar corner draw it, in three looks, so the colours live here once. The values
             are the owner-approved mockup's (7 November 2026), the same as the Cockpit's and the phone's. -->
        <SolidColorBrush x:Key="MissionBrush" Color="#4338CA" />
        <SolidColorBrush x:Key="MissionBorderBrush" Color="#6366F1" />
        <SolidColorBrush x:Key="MissionOutlineText" Color="#C7D2FE" />
        <SolidColorBrush x:Key="MissionWarningBrush" Color="#CA8A04" />
        <SolidColorBrush x:Key="MissionWarningText" Color="#FDE68A" />
        <SolidColorBrush x:Key="MissionWarningIcon" Color="#EAB308" />
        <!-- The Mission button's two icons, drawn on a 16 by 16 grid. Both buttons (the toolbar corner and the session
             tab bar) use these, so the shapes cannot drift apart. The warning triangle's dot is an Ellipse beside it. -->
        <StreamGeometry x:Key="MissionDocumentIconGeometry">M4,1.5 H9.5 L12.5,4.5 V14.5 H4 Z M9.5,1.5 V4.5 H12.5 M6,8 H10.5 M6,10.5 H10.5</StreamGeometry>
        <StreamGeometry x:Key="MissionWarningIconGeometry">M8,1.8 L15,14 H1 Z M8,6.2 V10</StreamGeometry>
    </Application.Resources>
</Application>
