<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CcDirector.Avalonia.DrainDirectorDialog"
        Title="Drain this Director"
        Width="660" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#252526">

    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" Text="Drain this Director for a restart"
                   Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" />

        <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="#CCCCCC" FontSize="12"
                   Text="Every session on this Director is asked to finish its turn, start nothing new, and write a handover. Seats are closed leaf-first as their documents land, and nothing is ever forced: a session that cannot reach a clean stop keeps running and the restart does not happen. The whole record is written to a workspace on the Gateway, which stays readable while this machine is down." />

        <TextBlock Grid.Row="2" Margin="0,14,0,6" Foreground="#CCCCCC" FontSize="13"
                   Text="Why are you restarting? Every session is told this." />
        <TextBox x:Name="TxtReason" Grid.Row="3"
                 Background="#1E1E1E" Foreground="#CCCCCC" BorderBrush="#3C3C3C"
                 Padding="8" FontSize="13" Watermark="update to the newest build" />

        <TextBlock x:Name="TxtPhase" Grid.Row="4" Margin="0,14,0,0"
                   Foreground="#9CDCFE" FontSize="13" TextWrapping="Wrap" />

        <Border Grid.Row="5" Margin="0,10,0,0" Background="#1E1E1E" BorderBrush="#3C3C3C"
                BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible">
                <SelectableTextBlock x:Name="TxtReport" Margin="10"
                                     Foreground="#CCCCCC" FontFamily="Consolas,monospace"
                                     FontSize="12" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnOpenFolder" Content="Open the documents"
                    Height="28" Padding="12,0" Click="BtnOpenFolder_Click"
                    Background="#3C3C3C" Foreground="#CCCCCC" BorderThickness="0"
                    Cursor="Hand" IsVisible="False" Margin="0,0,8,0" />
            <Button x:Name="BtnStart" Content="Start the drain"
                    Height="28" Padding="12,0" Click="BtnStart_Click"
                    Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" />
            <Button x:Name="BtnClose" Content="Close"
                    Height="28" Padding="12,0" Click="BtnClose_Click"
                    Background="#3C3C3C" Foreground="#CCCCCC" BorderThickness="0"
                    Cursor="Hand" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
