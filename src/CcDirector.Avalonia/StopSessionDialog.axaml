<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CcDirector.Avalonia.StopSessionDialog"
        Title="Stop session"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#252526">

    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

        <TextBlock x:Name="TxtHeading" Grid.Row="0" Text="Stop this session?"
                   Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

        <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="#CCCCCC" FontSize="12"
                   Text="This ends the agent process now. Nothing in the working tree is touched." />

        <TextBlock Grid.Row="2" Margin="0,16,0,6" Foreground="#CCCCCC" FontSize="13"
                   Text="Note (optional)" />
        <TextBox x:Name="TxtReason" Grid.Row="3"
                 Background="#1E1E1E" Foreground="#CCCCCC" CaretBrush="#CCCCCC"
                 BorderBrush="#3C3C3C" BorderThickness="1"
                 Padding="8" FontSize="13"
                 Watermark="spawned into the wrong mode" />

        <Border x:Name="PnlFailure" Grid.Row="4" Margin="0,14,0,0" IsVisible="False"
                Background="#2B1C1C" BorderBrush="#5A2D2D" BorderThickness="1">
            <SelectableTextBlock x:Name="TxtFailure" Margin="10"
                                 Foreground="#F0B4B4" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnClose" Content="Cancel"
                    Height="28" Padding="12,0" Click="BtnClose_Click"
                    Background="#3C3C3C" Foreground="#CCCCCC" BorderThickness="0"
                    Cursor="Hand" IsCancel="True" />
            <Button x:Name="BtnStop" Content="Stop the session"
                    Height="28" Padding="12,0" Click="BtnStop_Click"
                    Background="#007ACC" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
