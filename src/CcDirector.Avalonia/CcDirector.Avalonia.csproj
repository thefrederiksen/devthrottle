<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>cc-director</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Version comes from Directory.Build.props at the repo root (single source of truth). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS0618;CS0067;AVLN3001</NoWarn>
    <!-- CS0618: Avalonia clipboard API deprecation -->
    <!-- CS0067: Interface-required events not yet wired (WIP document viewer controls) -->
    <!-- AVLN3001: Dialogs have no parameterless constructor (instantiated from code, not XAML loader) -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Auto-update gate. Off by default so local/dev/slot builds never try to
         self-update. CI release builds pass -p:UpdaterEnabled=true, which emits
         the [assembly: AssemblyMetadata("UpdaterEnabled","true")] marker that
         UpdateService reads at startup (see src/CcDirector.Core/Update/). -->
    <UpdaterEnabled Condition="'$(UpdaterEnabled)' == ''">false</UpdaterEnabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(UpdaterEnabled)' == 'true'">
    <AssemblyMetadata Include="UpdaterEnabled" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.*" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Markdig" Version="0.38.0" />
    <PackageReference Include="Markdown.Avalonia" Version="11.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CcDirector.Core\CcDirector.Core.csproj" />
    <ProjectReference Include="..\CcDirector.Engine\CcDirector.Engine.csproj" />
    <ProjectReference Include="..\CcDirector.Terminal.Core\CcDirector.Terminal.Core.csproj" />
    <ProjectReference Include="..\CcDirector.Terminal.Avalonia\CcDirector.Terminal.Avalonia.csproj" />
    <ProjectReference Include="..\CcDirector.Gateway.Contracts\CcDirector.Gateway.Contracts.csproj" />
    <ProjectReference Include="..\CcDirector.ControlApi\CcDirector.ControlApi.csproj" />
    <!-- Setup engine: the Director drives silent tool auto-update (ToolUpdater) on its update loop. -->
    <ProjectReference Include="..\..\tools\cc-director-setup-engine\CcDirector.Setup.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Expose internal helpers (e.g. CleanViewDiff) to the unit-test project. -->
    <InternalsVisibleTo Include="CcDirector.Avalonia.Tests" />
  </ItemGroup>

  <!-- THE SESSION RULES HOOK EVALUATOR, CARRIED INSIDE THE DIRECTOR (Session Rules part 2, phase 1, ruling P16).
       A build for a Windows or Linux runtime identifier (every publish, and the slot builds) compiles
       cc-rule-hook to native code for the same platform and embeds it here as the resource "cc-rule-hook";
       ClaudeHookInstaller writes it out beside the hook scripts (RuleHookBinary). Carried, not shipped
       beside: the Director installs, updates and rolls back as ONE file, and the hook always matches it.
       A plain build with no runtime identifier (the tests, the solution) carries none and skips this.
       macOS is not given one yet: the Mac hook arrives in phase 4.
       Native compilation needs the platform's toolchain. Without it the build FAILS and says so; pass
       -p:EmbedRuleHook=false to build a Director that carries no hook on purpose. -->
  <PropertyGroup>
    <EmbedRuleHook Condition="'$(EmbedRuleHook)' == '' and ($(RuntimeIdentifier.StartsWith('win-')) or $(RuntimeIdentifier.StartsWith('linux-')))">true</EmbedRuleHook>
    <RuleHookProject>$(MSBuildThisFileDirectory)..\CcDirector.RuleHook\CcDirector.RuleHook.csproj</RuleHookProject>
    <RuleHookPublishDir>$(MSBuildThisFileDirectory)obj\rule-hook\$(Configuration)\$(RuntimeIdentifier)\</RuleHookPublishDir>
    <RuleHookExecutable>$(RuleHookPublishDir)cc-rule-hook</RuleHookExecutable>
    <RuleHookExecutable Condition="$(RuntimeIdentifier.StartsWith('win-'))">$(RuleHookPublishDir)cc-rule-hook.exe</RuleHookExecutable>
  </PropertyGroup>
  <ItemGroup Condition="'$(EmbedRuleHook)' == 'true'">
    <RuleHookSource Include="$(MSBuildThisFileDirectory)..\CcDirector.RuleHook\*.cs;$(RuleHookProject)" />
  </ItemGroup>

  <!-- Incremental: the evaluator is recompiled only when its source changed. -->
  <Target Name="PublishRuleHook" Condition="'$(EmbedRuleHook)' == 'true'" Inputs="@(RuleHookSource)" Outputs="$(RuleHookExecutable)">
    <Error Condition="'$(DOTNET_HOST_PATH)' == ''" Text="Building the Session Rules hook needs the dotnet host (DOTNET_HOST_PATH is not set). Build with the dotnet command line, or pass -p:EmbedRuleHook=false to build a Director that carries no hook." />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; publish &quot;$(RuleHookProject)&quot; -c $(Configuration) -r $(RuntimeIdentifier) -o &quot;$(RuleHookPublishDir)&quot; --nologo -v q" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="RuleHookPublishExitCode" />
    </Exec>
    <Error Condition="'$(RuleHookPublishExitCode)' != '0'" Text="cc-rule-hook could not be compiled to native code for $(RuntimeIdentifier) (exit code $(RuleHookPublishExitCode)). Native compilation needs the platform's toolchain: on Windows the Visual Studio 'Desktop development with C++' build tools, on Linux clang or gcc. To build a Director that carries NO Session Rules hook on purpose (its sessions evaluate no rules, and it logs that loudly), pass -p:EmbedRuleHook=false." />
  </Target>

  <Target Name="EmbedRuleHook" BeforeTargets="BeforeBuild" DependsOnTargets="PublishRuleHook" Condition="'$(EmbedRuleHook)' == 'true'">
    <Error Condition="!Exists('$(RuleHookExecutable)')" Text="The Session Rules hook was not produced at $(RuleHookExecutable)." />
    <ItemGroup>
      <!-- The LogicalName must match RuleHookBinary.ResourceName in CcDirector.Core. -->
      <EmbeddedResource Include="$(RuleHookExecutable)" LogicalName="cc-rule-hook" />
    </ItemGroup>
    <Message Importance="high" Text="Embedding the Session Rules hook: $(RuleHookExecutable)" />
  </Target>
</Project>