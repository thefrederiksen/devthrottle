<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:CcDirector.Avalonia.SmartRestart"
        x:Class="CcDirector.Avalonia.SmartRestart.WayUpOfferWindow"
        x:DataType="local:WayUpOfferViewModel"
        x:CompileBindings="True"
        Title="{Binding Headline}"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#252526">

    <!-- "A restart is available" (mission 5.3 item 10, ruling 10.2). Every word drawn here is the
         engine's, bound straight from WayUpOfferViewModel; this file lays them out and colours them
         and does nothing else. docs/VisualStyle.md: #252526 window, #1E1E1E panels, #CCCCCC primary
         text, #AAAAAA secondary, #888888 tertiary, #007ACC the primary action.

         THE SHAPE IS WHAT THE OWNER ASKED FOR ON 20 SEPTEMBER 2026. He photographed this window and
         could not read it: "why are there multiple sessions ... we're totally missing a date and time
         when that was saved ... It's really confusing with all of those on the screen." The date WAS
         on the screen, second line, under a headline saying one session was waiting, above seven rows
         of which six were greyed. So:
           - the date and time sit directly under the headline, in PRIMARY text, where the eye lands;
           - the main list holds ONLY what can be brought back, and the line above it counts exactly
             those rows, so the two agree;
           - the sessions that ended without a handover keep every bit of ruling 10.3 - listed,
             unticked, one reopen button each - behind one line saying how many there are. -->
    <Window.Styles>
        <!-- VisualStyle section 13: a disabled button stays readable and keeps its colour identity.
             Both answers are disabled while the engine is working, with the owner looking at them. -->
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1A8AD4" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#004E82" />
            <Setter Property="Foreground" Value="#6699BB" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#505050" />
            <Setter Property="Foreground" Value="#CCCCCC" />
        </Style>
        <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="Foreground" Value="#666666" />
        </Style>

        <!-- The house disclosure header: a full-width ToggleButton with the caret flush right and no
             default Expander chrome. Copied from Controls/GatewayConnectionPanel.axaml rather than
             invented, so the two read the same. -->
        <Style Selector="ToggleButton.disclosure">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.disclosure /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.disclosure:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.disclosure:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.disclosure:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- the headline, and when it was -->
            <RowDefinition Height="Auto" />  <!-- why, when there was a reason -->
            <RowDefinition Height="Auto" />  <!-- what the main list holds -->
            <RowDefinition Height="*" />     <!-- the main list, then the ended section -->
            <RowDefinition Height="Auto" />  <!-- what came of a bring back -->
            <RowDefinition Height="Auto" />  <!-- stop asking about this record at all -->
            <RowDefinition Height="Auto" />  <!-- the answers -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TxtHeadline"
                       Text="{Binding Headline}"
                       Foreground="#CCCCCC"
                       FontSize="18" FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <!-- WHEN, IN PRIMARY TEXT, DIRECTLY UNDER THE HEADLINE. It was secondary grey on the third
                 line before, and the owner read the whole window without seeing it. -->
            <TextBlock x:Name="TxtWhen"
                       Text="{Binding WhenLabel}"
                       Foreground="#CCCCCC"
                       FontSize="14" FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- The reason, and NOTHING AT ALL when there was none: the engine answers null, and a line
             reading "No reason was given." is noise on a window he called confusing. -->
        <TextBlock Grid.Row="1"
                   x:Name="TxtReason"
                   Text="{Binding ReasonLabel}"
                   IsVisible="{Binding HasReason}"
                   Foreground="#888888"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />

        <TextBlock Grid.Row="2"
                   x:Name="TxtSeats"
                   Text="{Binding SeatsLabel}"
                   Foreground="#CCCCCC"
                   FontSize="13" FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0" />

        <Border Grid.Row="3"
                Background="#1E1E1E"
                BorderBrush="#3C3C3C" BorderThickness="1"
                CornerRadius="4"
                Margin="0,8,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8">
                <ItemsControl x:Name="RowList"
                              ItemsSource="{Binding BringBackRows}"
                              IsVisible="{Binding HasBringBackRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:WayUpRowViewModel">
                            <StackPanel Margin="0,4,0,10">
                                <CheckBox IsChecked="{Binding Ticked, Mode=TwoWay}"
                                          IsEnabled="{Binding CanTick}"
                                          Content="{Binding Title}"
                                          Foreground="{Binding TitleBrush}"
                                          FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}"
                                           Foreground="#AAAAAA"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="26,0,0,0" />
                                <ItemsControl ItemsSource="{Binding Seats}"
                                              IsVisible="{Binding HasSeats}"
                                              Margin="26,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:WayUpSeatLineViewModel">
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="#888888"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,1,0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Reopen.WhatText}"
                                           IsVisible="{Binding Reopen.HasWhat}"
                                           Foreground="#888888"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="26,4,0,0" />
                                <Button Content="{Binding Reopen.OfferText}"
                                        IsVisible="{Binding Reopen.HasButton}"
                                        Classes="secondary"
                                        Click="BtnReopen_Click"
                                        Background="#3C3C3C" Foreground="#CCCCCC"
                                        BorderThickness="0"
                                        FontSize="12" Height="26"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"
                                        Margin="26,6,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- THE SESSIONS THAT ENDED WITHOUT A HANDOVER, behind one line (ruling 10.3 in full:
                     they are moved, not dropped). The header's words and whether it starts open are
                     both the engine's; this draws them. -->
                <StackPanel x:Name="EndedSection"
                            IsVisible="{Binding HasEndedSection}"
                            Margin="0,4,0,0">
                    <Border Background="#3C3C3C" Height="1"
                            IsVisible="{Binding HasBringBackRows}"
                            Margin="0,6,0,4" />
                    <ToggleButton x:Name="EndedToggle"
                                  Classes="disclosure"
                                  IsChecked="{Binding EndedSectionOpen, Mode=TwoWay}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       x:Name="TxtEndedSection"
                                       Text="{Binding EndedSectionLabel}"
                                       Foreground="#F59E0B"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       x:Name="TxtEndedCaret"
                                       Text="{Binding EndedCaret}"
                                       Foreground="#888888"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </ToggleButton>
                    <TextBlock x:Name="TxtEndedDetail"
                               Text="{Binding EndedSectionDetail}"
                               Foreground="#888888"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <ItemsControl x:Name="EndedRowList"
                                  ItemsSource="{Binding EndedRows}"
                                  IsVisible="{Binding EndedSectionOpen}"
                                  Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:WayUpRowViewModel">
                                <StackPanel Margin="0,4,0,10">
                                    <CheckBox IsChecked="{Binding Ticked, Mode=TwoWay}"
                                              IsEnabled="{Binding CanTick}"
                                              Content="{Binding Title}"
                                              Foreground="{Binding TitleBrush}"
                                              FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}"
                                               Foreground="#AAAAAA"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="26,0,0,0" />
                                    <TextBlock Text="{Binding Reopen.WhatText}"
                                               IsVisible="{Binding Reopen.HasWhat}"
                                               Foreground="#888888"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="26,4,0,0" />
                                    <Button Content="{Binding Reopen.OfferText}"
                                            IsVisible="{Binding Reopen.HasButton}"
                                            Classes="secondary"
                                            Click="BtnReopen_Click"
                                            Background="#3C3C3C" Foreground="#CCCCCC"
                                            BorderThickness="0"
                                            FontSize="12" Height="26"
                                            Cursor="Hand"
                                            HorizontalAlignment="Left"
                                            Margin="26,6,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="4"
                x:Name="ResultPanel"
                IsVisible="{Binding HasResult}"
                Background="#1E1E1E"
                BorderBrush="#3C3C3C" BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="TxtResult"
                           Text="{Binding ResultText}"
                           Foreground="#CCCCCC"
                           FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <ItemsControl x:Name="SeatResultList"
                              ItemsSource="{Binding SeatResults}"
                              IsVisible="{Binding HasSeatResults}"
                              Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}"
                                       Foreground="#888888"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- STOP ASKING ABOUT THIS RECORD AT ALL (the owner's ruling, 20 September 2026: "the user should
             also be able to clear it if they don't want it ... they don't want to see it on every upstart").

             IT IS DELIBERATELY NOT BESIDE THE PRIMARY PAIR. It sits on its own line, on the LEFT, under a
             divider, with the whole width of the window between it and the two answers at the bottom right,
             so a hand reaching for "Bring back" or "Not now" cannot land on it. It is drawn in secondary
             grey, never in the primary blue, because it is not the thing he came here to do.

             THE SENTENCE BESIDE IT IS THE ENGINE'S and it names "Not now" by name, so the difference between
             "ask me again next time" and "stop asking" is read off this window rather than out of a manual. -->
        <StackPanel Grid.Row="5"
                    x:Name="ClearPanel"
                    IsVisible="{Binding ShowClear}"
                    Margin="0,12,0,0">
            <Border Background="#3C3C3C" Height="1" />
            <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,0">
                <Button Grid.Column="0"
                        x:Name="BtnClear"
                        Classes="secondary"
                        Content="{Binding ClearText}"
                        IsEnabled="{Binding CanAnswer}"
                        Click="BtnClear_Click"
                        MinWidth="130" Height="28"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Top"
                        Background="#3C3C3C" Foreground="#CCCCCC"
                        BorderThickness="0" Cursor="Hand" />
                <TextBlock Grid.Column="1"
                           x:Name="TxtClearDetail"
                           Text="{Binding ClearDetail}"
                           IsVisible="{Binding HasClearDetail}"
                           Foreground="#888888"
                           FontSize="11"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>
        </StackPanel>

        <Grid Grid.Row="6" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
            <Button Grid.Column="1"
                    x:Name="BtnBringBack"
                    Classes="primary"
                    Content="{Binding BringBackText}"
                    IsVisible="{Binding ShowBringBack}"
                    IsEnabled="{Binding CanAnswer}"
                    Click="BtnBringBack_Click"
                    MinWidth="120" Height="30"
                    HorizontalContentAlignment="Center"
                    Background="#007ACC" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    IsDefault="True" />
            <Button Grid.Column="2"
                    x:Name="BtnNotNow"
                    Classes="secondary"
                    Content="{Binding NotNowText}"
                    IsVisible="{Binding ShowAnswers}"
                    IsEnabled="{Binding CanAnswer}"
                    Click="BtnNotNow_Click"
                    MinWidth="100" Height="30"
                    HorizontalContentAlignment="Center"
                    Background="#3C3C3C" Foreground="#CCCCCC"
                    BorderThickness="0" Cursor="Hand"
                    IsCancel="True"
                    Margin="8,0,0,0" />
            <Button Grid.Column="2"
                    x:Name="BtnClose"
                    Classes="primary"
                    Content="{Binding CloseText}"
                    IsVisible="{Binding HasResult}"
                    Click="BtnNotNow_Click"
                    MinWidth="100" Height="30"
                    HorizontalContentAlignment="Center"
                    Background="#007ACC" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Margin="8,0,0,0" />
        </Grid>
    </Grid>
</Window>
