<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CcDirector.Avalonia.SmartRestart.ShutdownProgressView"
             Background="#1E1E1E">

    <!-- docs/VisualStyle.md section 13: a disabled button stays readable and keeps its colour identity,
         dimmed. Both buttons here spend most of their life disabled with the owner looking at them, so
         the theme's own disabled look, which all but hides them, is not acceptable. -->
    <UserControl.Styles>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1A8AD4" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#004E82" />
            <Setter Property="Foreground" Value="#6699BB" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#505050" />
            <Setter Property="Foreground" Value="#CCCCCC" />
        </Style>
        <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="Foreground" Value="#666666" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </UserControl.Styles>

    <!-- Shown in place of the session view while a smart shutdown is under way. Every word about a
         state, a phase or a count is the engine's, read from ShutdownProgressViewModel as given; this
         file only lays it out. -->
    <Grid Margin="20" MaxWidth="760" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Grid.Column="0"
                       x:Name="CountText"
                       Text="{Binding CountText}"
                       Foreground="#CCCCCC"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Column="1"
                       x:Name="TimeLeftText"
                       Text="{Binding TimeLeftText}"
                       IsVisible="{Binding IsTimeLeftVisible}"
                       Foreground="#CCCCCC"
                       FontSize="14"
                       FontFamily="Cascadia Mono, Consolas, Courier New"
                       VerticalAlignment="Bottom" />
        </Grid>

        <TextBlock Grid.Row="1"
                   x:Name="PhaseText"
                   Text="{Binding PhaseText}"
                   Foreground="#AAAAAA"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />

        <TextBlock Grid.Row="2"
                   x:Name="NoteText"
                   Text="{Binding NoteText}"
                   IsVisible="{Binding HasNote}"
                   Foreground="#888888"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />

        <TextBlock Grid.Row="3"
                   x:Name="ResultText"
                   Text="{Binding ResultText}"
                   IsVisible="{Binding HasResult}"
                   Foreground="#CCCCCC"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,4,0,4" />

        <Border Grid.Row="4"
                Background="#252526"
                BorderBrush="#3C3C3C"
                BorderThickness="1"
                Margin="0,8,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RowList"
                              ItemsSource="{Binding Rows}"
                              Margin="0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="{Binding RowMargin}">
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Name}"
                                           Foreground="{Binding NameBrush}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding StateText}"
                                           Foreground="{Binding StateBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="12,0,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding DetailText}"
                                           IsVisible="{Binding HasDetail}"
                                           Foreground="#888888"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="5"
                    x:Name="ButtonPanel"
                    IsVisible="{Binding AreButtonsVisible}"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="BtnShutDownNow"
                    Classes="primary"
                    Content="Shut down now"
                    Click="BtnShutDownNow_Click"
                    IsEnabled="{Binding CanShutDownNow}"
                    Width="140" Height="30"
                    HorizontalContentAlignment="Center"
                    Background="#007ACC" Foreground="White"
                    BorderThickness="0" Cursor="Hand" />
            <Button x:Name="BtnCancelAndKeepWorking"
                    Classes="secondary"
                    Content="Cancel and keep working"
                    Click="BtnCancelAndKeepWorking_Click"
                    IsEnabled="{Binding CanCancel}"
                    Width="200" Height="30"
                    HorizontalContentAlignment="Center"
                    Background="#3C3C3C" Foreground="#CCCCCC"
                    BorderThickness="0" Cursor="Hand"
                    Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
