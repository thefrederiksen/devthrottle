<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CcDirector.Avalonia.Controls"
             x:Class="CcDirector.Avalonia.Controls.DirectorTeamPanel">

    <UserControl.Styles>
        <!-- A locked Move button stays readable, so the person sees WHAT is locked beside the reason. -->
        <Style Selector="Button#MoveButton:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#3C3C3C" />
            <Setter Property="Foreground" Value="#888888" />
        </Style>
    </UserControl.Styles>

    <!-- Screen D3 (devthrottle_internal#2311): which team this Director works for, and moving it to another -
         only with every session closed. Styled inline, so it draws the same in Settings and in a test window. -->
    <Border Background="#252526" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="4" Padding="16,14">
        <StackPanel Spacing="8">
            <TextBlock Text="Team" Foreground="#CCCCCC" FontSize="15" FontWeight="SemiBold" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="CurrentTeamText" Foreground="#AAAAAA" FontSize="13"
                           VerticalAlignment="Center" TextWrapping="Wrap" Text="Loading..." />
                <controls:TeamChip x:Name="CurrentTeamChip" />
            </StackPanel>

            <TextBlock x:Name="ExplainText" Foreground="#888888" FontSize="12" TextWrapping="Wrap"
                       Text="Every session on this Director belongs to its team: its skills, its Mentor page, its bill. A Director changes team only with every session closed, so no session starts on one team and finishes on another." />

            <Button x:Name="ChooseButton" Content="Choose another team..." Height="28" Padding="12,0"
                    HorizontalAlignment="Left" Margin="0,6,0,0"
                    Background="#3C3C3C" Foreground="#CCCCCC" BorderThickness="0" Cursor="Hand"
                    VerticalContentAlignment="Center"
                    Click="BtnChoose_Click"
                    ToolTip.Tip="Signs you in to DevThrottle in your browser and lists the teams you can move this Director to" />

            <StackPanel x:Name="MovePanel" Spacing="8" IsVisible="False" Margin="0,6,0,0">
                <ComboBox x:Name="TeamCombo" MinWidth="280" HorizontalAlignment="Left"
                          Background="#1E1E1E" Foreground="#CCCCCC" BorderBrush="#3C3C3C"
                          SelectionChanged="TeamCombo_SelectionChanged" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="MoveButton" Content="Move" Height="30" Padding="14,0"
                            Background="#007ACC" Foreground="White" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand" VerticalContentAlignment="Center"
                            Click="BtnMove_Click" />
                    <TextBlock x:Name="LockText" Foreground="#F59E0B" FontSize="12"
                               VerticalAlignment="Center" IsVisible="False" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" IsVisible="False" Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</UserControl>
