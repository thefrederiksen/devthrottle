<Window x:Class="CcDirector.Avalonia.BackgroundWorkDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Background work"
        Width="900" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#252526">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Background work"
                   Foreground="#CCCCCC"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Text="Every recurring job on the scheduler: what it is, how often it may run, when it last ran, and its runs in the last hour against its ceiling. The register of every job, on or off the scheduler, is docs/BackgroundWork.md in the product repository."
                   Foreground="#AAAAAA"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <!-- One row per job, built in code-behind from the scheduler's snapshot. -->
            <Grid x:Name="Rows" ColumnDefinitions="*,110,90,110,150,90,70" RowSpacing="6" ColumnSpacing="12" />
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="RefreshedText" Foreground="#888888" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="Close" Width="80" Height="28"
                    Background="#3C3C3C" Foreground="#CCCCCC"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnClose_Click" />
        </StackPanel>
    </Grid>
</Window>
