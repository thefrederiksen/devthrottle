<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CcDirector.Avalonia.Controls"
        x:Class="CcDirector.Avalonia.SettingsDialog"
        Title="Director Settings"
        Width="1040" Height="1010"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#252526">

    <Window.Styles>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="TextBox.settingsInput">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="CaretBrush" Value="#CCCCCC" />
            <Setter Property="BorderBrush" Value="#3C3C3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <!-- Read-only monospace "this is what launches" preview strip (issue #436). -->
        <Style Selector="TextBox.previewStrip">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="BorderBrush" Value="#3C3C3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- Rounded "card" container that groups related settings on the Advanced tab. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="BorderBrush" Value="#3C3C3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Button.dialogButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#3C3C3C" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.primaryButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#007ACC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Compact square icon button for Up/Down arrows and the trash Remove (issue #494). -->
        <Style Selector="Button.iconButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#3C3C3C" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Director Settings"
                   Foreground="#CCCCCC" FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,8" />

        <TextBlock x:Name="LoadingText" Grid.Row="1"
                   Text="Loading..."
                   Foreground="#888888" FontSize="12" FontStyle="Italic"
                   Margin="0,0,0,8" />

        <TabControl Grid.Row="2" x:Name="SettingsTabs" IsVisible="False">
            <TabItem Header="Account">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
                    <StackPanel Spacing="12" Margin="0,4,0,0">

                        <!-- Read-only gateway connection + identity panel (issue #651). The account is
                             managed by the Gateway, so the Director only READS the signed-in identity
                             from the Gateway's GET /account/status (issue #638) and displays it. There
                             are deliberately NO controls here: sign-in/sign-out lives on the Cockpit
                             (issue #648) and the usage-sharing choice is centralized on the Gateway
                             (issue #649). This panel never gates the Director - it is informational. -->
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="sectionTitle" Margin="0" Text="DevThrottle account" />
                                <TextBlock Classes="hint"
                                           Text="When this Director is connected to a Gateway, your account is managed there - sign-in, identity, and the usage-sharing choice are handled centrally by the Gateway. With no Gateway connected, this panel shows this Director's own DevThrottle sign-in. Either way it is informational; manage the connection and sign-in from the Gateway tab." />

                                <Grid ColumnDefinitions="110,*" Margin="0,8,0,0" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Gateway" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GatewayManagedUrlText" Grid.Row="0" Grid.Column="1" Text="Loading..."
                                               Foreground="#CCCCCC" FontSize="13" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldLabel" Text="Signed in as" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GatewayIdentityText" Grid.Row="1" Grid.Column="1" Text="Checking the Gateway..."
                                               Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <TextBlock Classes="hint" Margin="0,4,0,0"
                                           Text="Manage the Gateway connection and sign-in from the connection panel on the Gateway tab." />
                                <Button x:Name="ManageConnectionButton" Classes="dialogButton"
                                        Content="Manage connection..." Width="200"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Click="BtnManageConnection_Click"
                                        ToolTip.Tip="Open the Gateway connection panel on its current step" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Gateway">
                <!-- Gateway Connection mission, Phase 4 (design spec section 8): this tab IS the one
                     reusable GatewayConnectionPanel now. The old scattered controls (Gateway URL box,
                     Detect, Test, Director public URL + Detect, plain-text token box, "Connect to
                     Gateway..." and "Re-run setup wizard...") are all gone - the panel does the guided
                     scan, connect (which IS the test), and DevThrottle sign-in, and keeps manual address
                     entry + the masked token under its own Advanced disclosure. The panel is created in
                     code-behind (LoadAsync) so it opens on the resolver's current step. -->
                <Border x:Name="GatewaySettingsHost" Padding="0,4,14,0" />
            </TabItem>

            <TabItem Header="Team">
                <!-- Screen D3 (devthrottle_internal#2311): which team this Director works for, and moving it to
                     another with every session closed. Created in code-behind (LoadAsync). -->
                <Border x:Name="TeamSettingsHost" Padding="0,4,14,0" />
            </TabItem>

            <TabItem Header="Agents">
                <!-- Issue #494: list ONLY. Add/Edit happens in a separate modal (AgentEditorDialog),
                     so there is no inline editor here and the only Save is the dialog's Save and Close. -->
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Spacing="8" Margin="0,4,14,8">
                        <TextBlock Classes="sectionTitle" Text="Agents" />
                        <TextBlock Classes="hint" Text="Your agents, in the order they appear in New Session. Each entry is a configured agent CLI - you can add several of the same type (e.g. two Claude entries with different presets). Use the Up/Down arrows to reorder, Add Agent to create one, and Edit to set the executable, command-line preset, model, and arguments. The Setup wizard re-runs the full setup - agents, tools, code folders, screenshots and the gateway - leaving anything already set up alone." />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button x:Name="AddAgentButton" Classes="dialogButton" Content="+ Add Agent"
                                    Width="120" Click="BtnAddAgent_Click"
                                    ToolTip.Tip="Add a new agent entry to the list" />
                            <Button x:Name="RunWizardButton" Classes="dialogButton" Content="Setup wizard..."
                                    Width="150" Click="BtnRunWizard_Click"
                                    ToolTip.Tip="Re-run the full setup: agents, tools, where your code lives, screenshots, and the gateway. Anything already set up is left alone." />
                            <TextBlock x:Name="AgentToolsStatus" Text="" Foreground="#888888"
                                       FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                       IsVisible="False" />
                        </StackPanel>
                    </StackPanel>

                    <!-- CRUD list of agent entries (issue #489/#494). Columns: Order (Up/Down arrows),
                         Display name, Type, Enabled, Status pill, and a fixed-width right-aligned
                         Actions cell (Edit + trash) that never clips at the dialog's min width. -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
                        <StackPanel Spacing="4">
                            <!-- Header row. Actions is a fixed 132px last column with a right margin
                                 so it stays inside the panel even at minimum width. -->
                            <Grid ColumnDefinitions="70,*,96,60,90,132" Margin="8,0,16,2">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Order" />
                                <TextBlock Grid.Column="1" Classes="fieldLabel" Text="Display name" />
                                <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Type" />
                                <TextBlock Grid.Column="3" Classes="fieldLabel" Text="Enabled" />
                                <TextBlock Grid.Column="4" Classes="fieldLabel" Text="Status" />
                                <TextBlock Grid.Column="5" Classes="fieldLabel" Text="Actions" HorizontalAlignment="Right" />
                            </Grid>

                            <ItemsControl x:Name="AgentEntriesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E1E" BorderBrush="#3C3C3C" BorderThickness="1" Padding="8,6" Margin="0,0,16,2">
                                            <Grid ColumnDefinitions="70,*,96,60,90,132" VerticalAlignment="Center">
                                                <!-- Compact Up/Down arrow controls in one tight cell. -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                                                    <Button Classes="iconButton"
                                                            Tag="{Binding Id}" Click="BtnMoveUp_Click"
                                                            ToolTip.Tip="Move this agent up">
                                                        <Path Data="M 0,5 L 5,0 L 10,5 Z" Fill="#CCCCCC"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                    <Button Classes="iconButton"
                                                            Tag="{Binding Id}" Click="BtnMoveDown_Click"
                                                            ToolTip.Tip="Move this agent down">
                                                        <Path Data="M 0,0 L 5,5 L 10,0 Z" Fill="#CCCCCC"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="#CCCCCC"
                                                           FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,8,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" Foreground="#AAAAAA"
                                                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <CheckBox Grid.Column="3" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                          Foreground="#CCCCCC" VerticalAlignment="Center"
                                                          ToolTip.Tip="Whether this agent is available for launching" />
                                                <!-- Status pill: green OK / amber Failed / grey Not checked. -->
                                                <Border Grid.Column="4" CornerRadius="8" Padding="8,2"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{Binding StatusPillBackground}"
                                                        IsVisible="{Binding HasStatus}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{Binding StatusPillForeground}" />
                                                </Border>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                    <Button Classes="dialogButton" Content="Edit" MinWidth="56" Padding="10,0"
                                                            Tag="{Binding Id}" Click="BtnEditAgent_Click"
                                                            ToolTip.Tip="Edit this agent in a dialog" />
                                                    <!-- Trash icon: lid + can body drawn as vector paths. -->
                                                    <Button Classes="iconButton"
                                                            Tag="{Binding Id}" Click="BtnRemoveAgent_Click"
                                                            ToolTip.Tip="Remove this agent">
                                                        <Canvas Width="12" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Rectangle Canvas.Left="0" Canvas.Top="2" Width="12" Height="1.6" Fill="#E06C6C" />
                                                            <Rectangle Canvas.Left="4" Canvas.Top="0" Width="4" Height="2" Fill="#E06C6C" />
                                                            <Path Data="M 1,4 L 11,4 L 10,14 L 2,14 Z" Fill="#E06C6C" />
                                                            <Rectangle Canvas.Left="4" Canvas.Top="6" Width="1" Height="6" Fill="#252526" />
                                                            <Rectangle Canvas.Left="7" Canvas.Top="6" Width="1" Height="6" Fill="#252526" />
                                                        </Canvas>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="AgentEntriesEmpty" Text="No agents configured. Click + Add Agent to create one."
                                       Foreground="#888888" FontSize="12" FontStyle="Italic" Margin="8,8,0,0" IsVisible="False" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Browser profiles">
                <!-- Browsers feature (slice 2): the workshop for drivable automation browsers -
                     create, sign in once, rename, remove. The rail's pinned Browsers group is the
                     launch surface; this tab is where they are set up. All logic lives in the view. -->
                <controls:BrowserSettingsView x:Name="BrowsersView" />
            </TabItem>

            <TabItem Header="Directories">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
                    <StackPanel Spacing="8" Margin="0,4,0,0">
                        <TextBlock Classes="sectionTitle" Text="Screenshots" />
                        <TextBlock Classes="hint" Text="Where phone-uploaded images are filed so a session can read them by path. On a Mac this must be set explicitly." />
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox x:Name="ScreenshotsDirBox" Grid.Column="0" Classes="settingsInput"
                                     Watermark="e.g. /Users/username/Desktop" />
                            <Button x:Name="DetectScreenshotsButton" Grid.Column="1" Classes="dialogButton"
                                    Content="Detect" Margin="8,0,0,0"
                                    ToolTip.Tip="Find the folder where this OS saves screenshots"
                                    Click="BtnDetectScreenshots_Click" />
                            <Button x:Name="BrowseButton" Grid.Column="2" Classes="dialogButton"
                                    Content="Browse..." Margin="8,0,0,0"
                                    Click="BtnBrowse_Click" />
                        </Grid>
                        <TextBlock x:Name="ScreenshotsStatus" Text="" Foreground="#888888"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" IsVisible="False" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
                    <StackPanel Spacing="12" Margin="0,4,0,0">

                        <!-- Network and Firewall card. Lets the user turn off the Windows
                             notification that pops up the first time each new build opens its
                             local network port. -->
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="sectionTitle" Margin="0" Text="Network and Firewall" />
                                <TextBlock Classes="hint" Text="The first time you run a new build, Windows pops up a dialog asking whether to allow Director on public and private networks. It appears because Director opens a network port so its tools can reach it. Director only needs that port on this same computer, so the block does no harm - but the dialog interrupts testing every time the build changes." />
                                <TextBlock Classes="hint" Text="The button below turns off that Windows notification. Windows will ask you for administrator approval once; after you approve it, the dialog stops appearing for good." />
                                <Button x:Name="SuppressFirewallButton" Classes="dialogButton"
                                        Content="Stop the Windows firewall pop-up"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                        ToolTip.Tip="Turns off the Windows notification that asks to allow a new app on the network. Windows will ask you for administrator approval."
                                        Click="BtnSuppressFirewallPrompt_Click" />
                                <TextBlock x:Name="FirewallStatus" Text="" Foreground="#888888"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" IsVisible="False" />
                            </StackPanel>
                        </Border>

                        <!-- Alpha Features card. -->
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="sectionTitle" Margin="0" Text="Alpha Features" />
                                <TextBlock Classes="hint" Text="Unfinished features we are still testing. They may break, change, or disappear without notice, and no support is provided while they are in alpha." />
                                <CheckBox x:Name="AlphaFeaturesCheck"
                                          Content="Enable alpha features"
                                          IsChecked="False"
                                          Foreground="#CCCCCC" FontSize="13"
                                          Margin="0,4,0,0"
                                          IsCheckedChanged="AlphaCheck_Changed"
                                          ToolTip.Tip="Default: off. Shows untested features - no guarantees they work." />
                                <TextBlock Classes="hint" Margin="24,0,0,0"
                                           Text="When enabled you get: unverified coding agents, session handover, GitHub remote sessions, Assistant/Coach quick-launch, and the wake-word test below. Claude Code and Pi have verified drivers and are always available." />

                                <StackPanel x:Name="AlphaVoicePanel" Spacing="6" Margin="24,8,0,0" IsVisible="False">
                                    <TextBlock Text="Voice wake-word test" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Classes="hint" Text="Sandbox for tuning the hands-free wake-word grammar: say &quot;wingman&quot; to start, dictate, then &quot;wingman send&quot; or &quot;wingman cancel&quot;. Emits to an on-screen box only, never to a live session." />
                                    <Button x:Name="WakeWordTestButton" Classes="dialogButton"
                                            Content="Open Wake-Word Test" Width="170" HorizontalAlignment="Left"
                                            Click="BtnWakeWordTest_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Tools">
                <!-- Consolidated Tools screen: the download-and-repair card on top, the full tool
                     status dashboard (the same ToolsView the standalone page used) filling the rest.
                     One place to SEE which tool is missing/failing and to repair it. The button calls
                     the SAME shared engine routine (ToolUpdater.RepairPythonToolsAsync) the Home
                     "Fix it" button and the setup application use, so all three repair identically. -->
                <Grid RowDefinitions="Auto,*" Margin="0,4,0,0">
                    <Border Grid.Row="0" Classes="card" Margin="0,0,14,10">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Margin="0" Text="DevThrottle tools" />
                            <TextBlock Classes="hint"
                                       Text="These cc-* command-line tools are what your sessions call. The list below shows each tool's status. If a tool is missing or stops working - for example after a new tool is added that this machine does not have yet - click Download and repair tools: it downloads the latest tool bundle and rebuilds everything in place, so you do not have to run a full reinstall. It can take a few minutes the first time, and you can keep using DevThrottle while it runs." />

                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                                <Button x:Name="FixToolsButton"
                                        Content="Download and repair tools"
                                        Background="#007ACC" Foreground="White"
                                        FontSize="15" FontWeight="SemiBold"
                                        Height="52" MinWidth="280"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="BtnFixTools_Click"
                                        ToolTip.Tip="Download the latest cc-* tool bundle and rebuild all tools in place" />
                                <TextBlock x:Name="FixToolsStatus" Text="" Foreground="#888888"
                                           FontSize="12" TextWrapping="Wrap" MaxWidth="420"
                                           VerticalAlignment="Center" IsVisible="False" />
                            </StackPanel>

                            <!-- Automatic-update opt-out (issue #828). ON by default; bound to the
                                 config key tools.autoUpdate.enabled, which the lifecycle reconciler
                                 honors. Turning it off stops all automatic reconciles and leaves the
                                 manual "Download and repair tools" button above as the only path.
                                 Persists immediately on toggle through the same config store. -->
                            <Border BorderBrush="#3C3C3C" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                                <StackPanel Spacing="4">
                                    <CheckBox x:Name="AutoUpdateToolsCheck"
                                              Content="Automatically keep cc-* tools up to date"
                                              IsChecked="True"
                                              Foreground="#CCCCCC" FontSize="13"
                                              IsCheckedChanged="AutoUpdateToolsCheck_Changed"
                                              ToolTip.Tip="When on, the Director repairs and updates its cc-* tools by itself in the background. Turn off to pin your tools and update only with the button above." />
                                    <TextBlock Classes="hint" Margin="24,0,0,0"
                                               Text="When on, the Director repairs and updates its cc-* tools by itself in the background, so you never have to maintain them. Turn it off to pin your tools; then they change only when you click Download and repair tools above." />
                                    <TextBlock x:Name="AutoUpdateToolsStatus" Margin="24,2,0,0"
                                               Foreground="#888888" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <controls:ToolsView Grid.Row="1" x:Name="EmbeddedToolsView" Margin="0,0,14,0" />
                </Grid>
            </TabItem>

        </TabControl>

        <TextBlock x:Name="StatusText" Grid.Row="3"
                   Text="" Foreground="#888888" FontSize="11"
                   TextWrapping="Wrap" Margin="0,8,0,0" />

        <!-- Bottom row: Open config.json link on the left (replaces the old Advanced
             read-only dump); Save / Cancel on the right. -->
        <Grid Grid.Row="4" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
            <Button Grid.Column="0" x:Name="OpenConfigButton"
                    Content="Open config.json"
                    Background="Transparent" BorderThickness="0"
                    Foreground="#3B82F6" Cursor="Hand"
                    Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    ToolTip.Tip="Open the Director config.json in your default editor"
                    Click="BtnOpenConfig_Click" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SaveButton" Classes="primaryButton" Content="Save and Close"
                        IsDefault="True" Click="BtnSave_Click" />
                <Button Content="Cancel" Classes="dialogButton" Width="100" Margin="8,0,0,0"
                        IsCancel="True" Click="BtnClose_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
