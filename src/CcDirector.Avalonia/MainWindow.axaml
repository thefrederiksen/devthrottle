<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:terminal="clr-namespace:CcDirector.Terminal.Avalonia;assembly=CcDirector.Terminal.Avalonia"
        xmlns:controls="clr-namespace:CcDirector.Avalonia.Controls"
        xmlns:commMgr="clr-namespace:CcDirector.Avalonia.Controls.CommManager"
        xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
        x:Class="CcDirector.Avalonia.MainWindow"
        Title="Director"
        Width="1400" Height="900"
        MinWidth="800" MinHeight="500"
        Background="{DynamicResource PanelBackground}"
        Icon="avares://cc-director/app.ico">

    <Window.Styles>
        <!-- Toolbar buttons: flat, icon + label, subtle hover. The New Session
             button opts out (accent styling inline) since it is the primary action. -->
        <Style Selector="Button.toolbarBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.toolbarBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2D2D30" />
        </Style>

        <!-- Panel collapse/expand chevrons: a subtle vector chevron that brightens on
             hover. Replaces the old "&lt;&lt;"/"&gt;&gt;" text toggles. Each chevron points
             toward the edge its panel tucks into (left panel -> left, right panel -> right). -->
        <Style Selector="Button.panelToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.panelToggle Path">
            <Setter Property="Stroke" Value="#888888" />
        </Style>
        <Style Selector="Button.panelToggle:pointerover Path">
            <Setter Property="Stroke" Value="#E0E0E0" />
        </Style>
        <Style Selector="Button.panelToggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!-- Collapsed-sidebar status dots: subtle border that brightens on hover. -->
        <Style Selector="Button.slimDot:pointerover Border">
            <Setter Property="BorderBrush" Value="#FFFFFF" />
        </Style>
    </Window.Styles>

    <!-- The menu bar and toolbar span the full window width above the sidebar and
         content. NativeMenuBar renders an in-window menu bar on Windows/Linux and
         lifts into the system menu bar on macOS automatically. The menu items are
         built in code-behind (BuildNativeMenu) and assigned via NativeMenu.SetMenu. -->
    <DockPanel>

        <!-- ==================== MENU BAR (full width) ==================== -->
        <NativeMenuBar DockPanel.Dock="Top" />

        <!-- ==================== TOOLBAR (full width) ====================
             High-frequency actions + the badge bearers that cannot live inside
             a collapsed menu (Comms pending count). -->
        <Border x:Name="MainToolbar"
                DockPanel.Dock="Top"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="#3C3C3C" BorderThickness="0,0,0,1"
                Padding="8,4">
            <DockPanel>
                <!-- Right group: this Director's identity + global destinations + Settings -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Spacing="2" VerticalAlignment="Center">
                    <!-- WHICH Director this is: its own name, plus a Copy that hands another
                         agent the command to open a session on it. This identifies the WHOLE
                         application's Director, so it belongs on the app-wide toolbar, not in
                         the per-session blue header. Always visible, even with no session.
                         (It showed the machine name and Control API port until nothing reached
                         a Director by port any more, and one machine ran several Directors.) -->
                    <StackPanel x:Name="DirectorInfoPanel" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock x:Name="DirectorInfoText"
                                   Text="..."
                                   Foreground="#CCCCCC"
                                   FontSize="11"
                                   FontFamily="Cascadia Mono,Consolas,monospace"
                                   VerticalAlignment="Center" />
                        <Button x:Name="BtnCopyDirectorInfo"
                                Content="Copy"
                                Click="BtnCopyDirectorInfo_Click"
                                Margin="8,0,0,0"
                                Padding="6,2"
                                FontSize="11"
                                Background="#2D2D30"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip.Tip="Copy this Director's name, id, and machine - paste it to an agent so it can reach this Director" />
                    </StackPanel>

                    <Border Width="1" Height="18" Background="#3C3C3C"
                            Margin="6,0" VerticalAlignment="Center" />

                    <!-- The Tools catalog button was retired: the tool status + repair now live in
                         Settings -> Tools (opened from the rail tools indicator). -->

                    <!-- The in-window Fleet Map was removed: the Cockpit button beside this one is the
                         single fleet-wide door, and having two of them was confusing. -->

                    <!-- Cockpit (asks the local gateway for the Tailscale URL, then opens it) -->
                    <Button x:Name="BtnCockpit" Classes="toolbarBtn"
                            Click="BtnCockpit_Click"
                            ToolTip.Tip="Open the Cockpit (single fleet UI) over Tailscale">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15">
                                <Path Stroke="#CCCCCC" StrokeThickness="1.3" Fill="Transparent"
                                      Data="M8,1 A7,7 0 1 1 7.99,1 M8,3 V8 L11.5,11.5 M3,8 H1 M15,8 H13 M8,3 V1" />
                            </Viewbox>
                            <TextBlock Text="Cockpit" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="18" Background="#3C3C3C"
                            Margin="6,0" VerticalAlignment="Center" />

                    <!-- Settings -->
                    <Button x:Name="BtnSettings" Classes="toolbarBtn"
                            Click="BtnSettings_Click"
                            ToolTip.Tip="Director settings">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15">
                                <Path Fill="#CCCCCC"
                                      Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" />
                            </Viewbox>
                            <TextBlock Text="Settings" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Left group: primary session actions -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="BtnNewSession"
                            Click="BtnNewSession_Click"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="3"
                            Padding="10,4"
                            Height="30"
                            Cursor="Hand"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Create a new session">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Viewbox Width="13" Height="13">
                                <Path Fill="White" Data="M6,0 H8 V6 H14 V8 H8 V14 H6 V8 H0 V6 H6 Z" />
                            </Viewbox>
                            <TextBlock Text="New Session" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

    <Grid x:Name="MainLayoutGrid" ColumnDefinitions="264,Auto,*" RowDefinitions="Auto,*">

        <!-- ==================== SIDEBAR (spans both rows) ==================== -->
        <Border Grid.Column="0" Grid.RowSpan="2"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="#3C3C3C" BorderThickness="0,0,1,0">
            <Grid>
            <DockPanel x:Name="SidebarFullPanel">
                <!-- Sidebar header: title + needs-you count + collapse toggle. The
                     application menu moved to the window menu bar; New Session moved
                     to the toolbar. -->
                <Border DockPanel.Dock="Top" Padding="8,6">
                    <DockPanel>
                        <!-- Collapse the sidebar to the slim status strip. Chevron points
                             left, toward the edge the panel tucks into. -->
                        <Button DockPanel.Dock="Right"
                                Click="SidebarCollapse_Click"
                                Focusable="False"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Collapse the session panel"
                                Classes="panelToggle">
                            <Viewbox Width="8" Height="12">
                                <Path Data="M 7,2 L 3,7 L 7,12"
                                      StrokeThickness="1.6"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                            </Viewbox>
                        </Button>
                        <!-- The two-position order switch (Session List Views, 14 September 2026).
                             My order is the drag order the rail has always opened on, and is the
                             Director's default; Attention is the Gateway's own sections, longest
                             wait on top. It applies to the TOP LEVEL ONLY - children never re-sort,
                             because a child with a live supervisor never goes red, so there is
                             nothing under a parent for attention to reorder. There is no third
                             position: machine, repository and agent are filters, not orders. -->
                        <Border DockPanel.Dock="Right"
                                BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="4"
                                ClipToBounds="True"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="How the top level is ordered">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnRailOrderMine"
                                        Content="My order"
                                        Click="RailOrderMine_Click"
                                        Focusable="False"
                                        FontSize="10" FontWeight="SemiBold"
                                        Padding="8,2" MinWidth="0"
                                        BorderThickness="0" CornerRadius="0"
                                        Cursor="Hand"
                                        ToolTip.Tip="Your own order - drag the rows where you want them" />
                                <Button x:Name="BtnRailOrderAttention"
                                        Content="Attention"
                                        Click="RailOrderAttention_Click"
                                        Focusable="False"
                                        FontSize="10" FontWeight="SemiBold"
                                        Padding="8,2" MinWidth="0"
                                        BorderThickness="0" CornerRadius="0"
                                        Cursor="Hand"
                                        ToolTip.Tip="The session that has needed you longest on top, then the rest that need you, then working, then snoozed" />
                            </StackPanel>
                        </Border>
                        <!-- "What do the colours mean?" - the same question the Cockpit and the phone
                             answer, on the surface that is open all day. The words come from the Gateway;
                             this button only opens the window that renders them. -->
                        <Button DockPanel.Dock="Right"
                                x:Name="BtnColourLegend"
                                Content="?"
                                Click="ColourLegend_Click"
                                Focusable="False"
                                FontSize="11" FontWeight="Bold"
                                Padding="7,1" MinWidth="0"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Background="#3C3C3C" Foreground="#CCCCCC"
                                BorderThickness="0" CornerRadius="4"
                                Cursor="Hand"
                                ToolTip.Tip="What do the colours mean?" />
                        <TextBlock Text="SESSIONS"
                                   Foreground="{DynamicResource TextForeground}"
                                   FontSize="12" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0" />
                        <!-- At-a-glance "do I need to act?" count: how many sessions are red
                             (needs you). Amber, hidden when zero. Updated from the session timer. -->
                        <TextBlock x:Name="SessionsNeedYouText"
                                   Foreground="#F0B848" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   IsVisible="False" />
                    </DockPanel>
                </Border>

                <!-- New Session moved to the top toolbar. -->

                <!-- Version footer (very bottom): "v0.6.3 (1cc1abd)", build time in tooltip. -->
                <Border DockPanel.Dock="Bottom" Padding="8,4">
                    <TextBlock x:Name="BuildInfoText"
                               Text=""
                               Foreground="#555555"
                               FontSize="10"
                               HorizontalAlignment="Center" />
                </Border>

                <!-- Gateway connection status box (Gateway Connection mission, Phase 3 - design spec
                     section 6). The two former boxes (GatewayIndicator + AccountIndicator) are merged
                     into ONE box with two check lines and four visual states:
                       AMBER  = needs attention (NotConfigured, or Connected but not signed in);
                       YELLOW = a handshake is verifying (gateway host + "Connecting...");
                       GREEN  = handshake proven AND the Gateway reports signed in (both lines filled);
                       RED    = connection failed, or was working and is now unreachable (gateway host + verdict).
                     GREEN is EARNED - the two-way nonce handshake for line 1, the Gateway's own account
                     report for line 2; a heartbeat or a cached value never paints either green. One click
                     opens the Gateway Connection panel on the resolver's current step. All colors, glyphs,
                     text and the tooltip are set from code-behind via GatewayStatusBoxPresenter, which runs
                     the same GatewayConnectionStateResolver the panel uses (so box and panel never disagree). -->
                <!-- Slimmed to a compact chip (Browsers feature, slice 2): a status dot plus the
                     presenter's short verdict. The dot and text carry the four visual states; the two
                     full check lines (which gateway, which account) moved into the tooltip. Same click
                     target, same panel. -->
                <Border x:Name="GatewayStatusBox" DockPanel.Dock="Bottom"
                        Margin="8,0,8,6" Padding="10,5" CornerRadius="12"
                        Background="#2A2A2A" BorderBrush="#3C3C3C" BorderThickness="1"
                        HorizontalAlignment="Left"
                        Cursor="Hand"
                        Focusable="True"
                        KeyDown="GatewayStatusBox_KeyDown"
                        PointerPressed="GatewayStatusBox_PointerPressed">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse x:Name="GatewayChipDot" Width="8" Height="8"
                                 Fill="#F0B848" VerticalAlignment="Center" />
                        <TextBlock x:Name="GatewayChipText"
                                   Text="Checking Gateway..."
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#F0B848"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- cc-* tools health indicator (sits directly above the Gateway indicator).
                     Active, self-healing badge (issue #829): hidden when every tool passes (green),
                     orange "Syncing tools..." with a progress spinner while an automatic reconcile
                     runs, the legacy amber warning when auto-update is off, and red "Tools need
                     attention" only after a reconcile fails repeatedly. All colors / text / the
                     spinner visibility are set from code-behind off the ToolsSyncStateMachine; click
                     opens Settings on the Tools tab (the actionable Warning / NeedsAttention states). -->
                <Border x:Name="ToolsIndicator" DockPanel.Dock="Bottom"
                        Margin="8,0,8,4" Padding="10,8" CornerRadius="4"
                        Background="#3A331B" BorderBrush="#F0B848" BorderThickness="1"
                        Cursor="Hand" IsVisible="False"
                        PointerPressed="ToolsIndicator_PointerPressed">
                    <StackPanel Orientation="Vertical" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Grid Width="22" Height="22" VerticalAlignment="Center">
                                <Ellipse x:Name="ToolsIndicatorDot" Fill="#F0B848" />
                                <TextBlock x:Name="ToolsIndicatorGlyph" Text="!" Foreground="#1E1E1E"
                                           FontWeight="Bold" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ToolsIndicatorLabel"
                                           Text="cc-* tools"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#F0B848" />
                                <TextBlock x:Name="ToolsIndicatorSub"
                                           Text="click to download and repair the tools"
                                           FontSize="10" Foreground="#B59868"
                                           TextWrapping="Wrap" MaxWidth="186"
                                           MaxLines="3" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <!-- Indeterminate progress while reconciling, so the orange state reads as live
                             work in progress rather than a frozen badge. Shown only in the Syncing state. -->
                        <ProgressBar x:Name="ToolsIndicatorSpinner" Height="3"
                                     IsIndeterminate="True" IsVisible="False"
                                     Foreground="#E0822E" Background="#2A2113" />
                    </StackPanel>
                </Border>

                <!-- Auto-update status. ALWAYS VISIBLE (issue #1030): it used to hide itself
                     whenever there was "nothing to report", which meant up to date, never
                     checked, and a check that failed all looked the same as each other and
                     the same as a broken feature. Every word, color and offered action comes
                     finished from UpdateStatusFold - this markup decides nothing. -->
                <Border x:Name="UpdateIndicator" DockPanel.Dock="Bottom"
                        Margin="8,0,8,4" Padding="10,8" CornerRadius="4"
                        Background="#242424" BorderBrush="#3C3C3C" BorderThickness="1"
                        PointerPressed="UpdateIndicator_PointerPressed">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                            <Path x:Name="UpdateIndicatorIcon"
                                  Fill="#8A8A8A"
                                  Data="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 Z M8,3 A5,5 0 1 1 8,13 A5,5 0 1 1 8,3 Z" />
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateIndicatorLabel"
                                       Text="NOT CHECKED YET"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#8A8A8A" />
                            <TextBlock x:Name="UpdateIndicatorSub"
                                       Text=""
                                       FontSize="10" Foreground="#666666"
                                       TextWrapping="Wrap" MaxWidth="186"
                                       MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <!-- The action the fold says is available, in its own words. Absent
                                 when nothing can usefully be done, so there is never a button
                                 offering something that cannot work. -->
                            <TextBlock x:Name="UpdateIndicatorAction"
                                       Text="" IsVisible="False" Margin="0,3,0,0"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#8A8A8A"
                                       TextDecorations="Underline"
                                       TextWrapping="Wrap" MaxWidth="186" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The Control API status indicator that used to sit here is gone with the
                     listener itself (Remove-the-network-port mission): nothing binds, so there
                     is no bind failure to report. Fleet reachability is the Gateway status box. -->

                <!-- Communications / Connections moved to the top toolbar
                     (their pending-count badge rides along with them). -->

                <!-- Pinned Repositories entry: opens the non-modal Repositories view over the
                     center content, just above the connection indicators (issue #507, phase 4). -->
                <Button x:Name="BtnRepositories" DockPanel.Dock="Bottom"
                        Click="BtnRepositories_Click"
                        Background="#2A2A2A" BorderBrush="#3C3C3C" BorderThickness="1"
                        Margin="8,4,8,6" Padding="10,8" CornerRadius="4"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand"
                        ToolTip.Tip="Repositories and worktrees across your machine">
                    <DockPanel LastChildFill="True">
                        <!-- Orphaned-worktree count: the reap opportunity, visible without opening. -->
                        <Border x:Name="RepositoriesBadge" DockPanel.Dock="Right"
                                Background="#EF4444" CornerRadius="8" Padding="6,1"
                                VerticalAlignment="Center" IsVisible="False"
                                ToolTip.Tip="Worktrees safe to reap">
                            <TextBlock x:Name="RepositoriesBadgeText" Text="0" Foreground="White"
                                       FontSize="9" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="[R]" Foreground="#4A9EFF" FontFamily="Cascadia Mono, Consolas"
                                       FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="Repositories" Foreground="#CCCCCC" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Button>

                <!-- Pinned Browser profiles entry: ONE clickable row, exactly like the pinned
                     Repositories entry below it - the profile count and a dot when any is running,
                     no list and no per-profile action. All content is the Core fold rendered
                     verbatim; the control raises ManageRequested to open Settings > Browsers, where
                     starting, signing in and attaching live. -->
                <controls:BrowsersRailGroup x:Name="BrowsersRail" DockPanel.Dock="Bottom" />

                <!-- Session list -->
                <ListBox x:Name="SessionList"
                         Background="Transparent"
                         Padding="4"
                         SelectionChanged="SessionList_SelectionChanged"
                         DragDrop.AllowDrop="True">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                        <Style Selector="Button.sessionMenuBtn:pointerover /template/ ContentPresenter">
                            <Setter Property="Foreground" Value="#CCCCCC" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,1">
                                <!-- Attention section heading ("NEEDS YOU 2"), on the FIRST row of the
                                     section only. Present only in attention order; my order has no
                                     sections. The words and the count come from the shared fold's
                                     AttentionSections, and the colour is red for needs you and muted
                                     for the rest - the only place the rail tells the sections apart. -->
                                <TextBlock IsVisible="{Binding ShowSectionHeader}"
                                           Text="{Binding SectionHeaderText}"
                                           Foreground="{Binding SectionHeaderBrush}"
                                           FontSize="10" FontWeight="Bold"
                                           Margin="8,8,8,2" />
                                <!-- Group header (issue #225): rendered above the FIRST member
                                     of a group only. Doubles as the group drag handle - grab it
                                     to move every member as one unit. -->
                                <Border IsVisible="{Binding ShowGroupHeader}"
                                        Background="#243049"
                                        BorderBrush="#3A4A63" BorderThickness="1,1,1,0"
                                        CornerRadius="6,6,0,0"
                                        Padding="9,4" Margin="0,3,0,0"
                                        Cursor="SizeAll"
                                        PointerPressed="ColorSquare_PointerPressed">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="&#9776;" Foreground="#6F86B3" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding GroupHeaderText}"
                                                   Foreground="#9DB4DD" FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <!-- Row body: a left accent stripe + subtle tint when this is a
                                     group member, so members read as one tied block. -->
                                <Border Background="{Binding GroupRowBackground}">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                                    <Border Grid.Column="0" Width="3"
                                            Background="{Binding GroupAccent}"
                                            IsVisible="{Binding IsGroupMember}" />
                                    <!-- THE OWNERSHIP TREE (Session List Views, slice 2). Three fixed
                                         columns in front of the row body, all of them stamped by
                                         SessionRailTree.Project from the shared fold:
                                           1. the depth indent, so a grandchild sits further in than a child;
                                           2. the guide line a crew's sessions hang behind;
                                           3. the chevron gutter, RESERVED ON EVERY ROW so that rows with
                                              and without a crew still line up with each other.
                                         An ordinary row therefore renders pixel for pixel as it always
                                         did, one gutter further in. -->
                                    <Border Grid.Column="1" Width="{Binding RailIndentWidth}" />
                                    <Border Grid.Column="2" Width="1" Margin="0,2,11,2"
                                            Background="#3A4A63"
                                            IsVisible="{Binding IsRailChild}" />
                                    <Border Grid.Column="3" Width="14">
                                        <Button IsVisible="{Binding HasCrew}"
                                                Click="CrewChevron_Click"
                                                Focusable="False"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="0" Margin="0"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Cursor="Hand"
                                                ToolTip.Tip="Open or close the sessions under this one">
                                            <Panel Width="10" Height="10">
                                                <!-- Closed: points right. Open: points down. Two paths
                                                     rather than a rotation, so neither state depends on a
                                                     transform the theme could restyle. -->
                                                <Path Data="M 3,1 L 7,5 L 3,9"
                                                      Stroke="#9DB4DD" StrokeThickness="1.6"
                                                      StrokeLineCap="Round" StrokeJoin="Round"
                                                      IsVisible="{Binding !IsCrewExpanded}" />
                                                <Path Data="M 1,3 L 5,7 L 9,3"
                                                      Stroke="#9DB4DD" StrokeThickness="1.6"
                                                      StrokeLineCap="Round" StrokeJoin="Round"
                                                      IsVisible="{Binding IsCrewExpanded}" />
                                            </Panel>
                                        </Button>
                                    </Border>
                                <!-- Session row content: up to three stacked lines, each
                                     element with a guaranteed slot so nothing is ever
                                     pushed out of the panel by something else growing:
                                       1. status dot | title (trims) | queue | kebab
                                       2. agent badge + type badge
                                       3. activity + waiting | changes (right-anchored) -->
                                <StackPanel Grid.Column="4" Margin="8,6">
                                    <!-- LINE 1: the title sits in the star column, so
                                         TextTrimming actually engages and a long name
                                         can never run under the kebab menu. -->
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <!-- Live status indicator. Binds StatusColorBrush, which folds
                                             ControlEndpoints.Map(Session) through
                                             SessionOrdering.EffectiveColor - the SAME fold the phone and
                                             Cockpit run - so every screen answers from one rule.

                                             It used to say "reads Session.StatusColor (written by the
                                             SessionStatusWingman) so the same session shows the same
                                             color on Desktop and Gateway". Reading the Director's raw
                                             colour is exactly WHY the desktop and the Gateway disagreed:
                                             two independent deciders, one comment asserting they agreed.
                                             The claim outlived the design by describing the intent
                                             instead of the wiring.

                                             Doubles as the drag handle for reordering the session list. -->
                                        <Border Grid.Column="0"
                                                Width="14" Height="14"
                                                CornerRadius="3"
                                                Background="{Binding StatusColorBrush}"
                                                ToolTip.Tip="{Binding ColourHover}"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Cursor="SizeAll"
                                                PointerPressed="ColorSquare_PointerPressed" />
                                        <!-- Issue #820: three-digit session number as a muted
                                             prefix (tertiary #888888), separate from the name so a
                                             rename never affects it. -->
                                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding NumberBadge}"
                                                       IsVisible="{Binding HasNumber}"
                                                       ToolTip.Tip="Session number"
                                                       Foreground="#888888"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       ToolTip.Tip="{Binding DisplayName}"
                                                       Foreground="{DynamicResource TextForeground}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <!-- Queue count badge (click to preview queued prompts) -->
                                        <Button Grid.Column="2"
                                                IsVisible="{Binding HasQueuedItems}"
                                                Click="QueuePreview_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Margin="4,0,2,0"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                ToolTip.Tip="Preview queued prompts (text + images)">
                                            <Border Background="#EF4444"
                                                    CornerRadius="9"
                                                    MinWidth="18" Height="18"
                                                    Padding="5,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding QueueCount}"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Button>
                                        <Button Grid.Column="3"
                                                Content="..."
                                                Click="SessionMenuButton_Click"
                                                Focusable="False"
                                                VerticalAlignment="Center"
                                                Padding="6,2"
                                                Margin="0"
                                                MinWidth="24"
                                                Background="Transparent"
                                                Foreground="#AAAAAA"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                FontWeight="Bold"
                                                FontSize="12"
                                                ToolTip.Tip="Session options"
                                                Classes="sessionMenuBtn" />
                                    </Grid>
                                    <!-- LINE 2: identity badges only - the wide items.
                                         Alone on their own line they always fit. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <!-- In-voice-mode ear indicator (issue #554): shown only
                                             while a phone is watching this session through the Voice
                                             (in-car) tab. A vector ear (outer fold + inner canal),
                                             never a glyph, tinted with the active-icon foreground so
                                             it reads as an indicator, not a status color. -->
                                        <Viewbox Width="14" Height="14"
                                                 IsVisible="{Binding IsVoiceMode}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,6,0"
                                                 ToolTip.Tip="In voice mode - a phone is driving this session by voice">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="{DynamicResource TextForeground}"
                                                      StrokeThickness="2"
                                                      StrokeLineCap="Round"
                                                      StrokeJoin="Round"
                                                      Fill="Transparent"
                                                      Data="M7 11 C7 6.6 10.1 4 12.5 4 C15.5 4 18 6.4 18 9.5 C18 12.4 16 13.7 14.7 14.7 C13.7 15.5 13 16.1 13 17.2 C13 18.7 11.9 19.9 10.4 19.9 C9 19.9 7.9 18.8 7.9 17.4" />
                                                <Path Stroke="{DynamicResource TextForeground}"
                                                      StrokeThickness="2"
                                                      StrokeLineCap="Round"
                                                      StrokeJoin="Round"
                                                      Fill="Transparent"
                                                      Data="M10.2 10.4 C10.2 9.1 11.2 8.1 12.5 8.1 C13.8 8.1 14.8 9.1 14.8 10.4 C14.8 11.6 13.9 12.1 13.2 12.7" />
                                            </Canvas>
                                        </Viewbox>
                                        <!-- Role badge: a small NON-color glyph for the session's
                                             automatic role - "M" Manager, "W" Worker, "A" Architect
                                             (nothing for Standalone). Deliberately a muted neutral
                                             gray, never a status color, so it does not compete with
                                             the status dot; the tooltip gives the full role name. -->
                                        <Border Background="{DynamicResource ButtonBackground}"
                                                CornerRadius="6"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0"
                                                IsVisible="{Binding HasRoleGlyph}"
                                                ToolTip.Tip="{Binding RoleTooltip}">
                                            <TextBlock Text="{Binding RoleGlyphText}"
                                                       Foreground="{DynamicResource TextForeground}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <!-- Not-delivered badge (issue internal#811): a prompt to this
                                             session never reached the agent - the user's words are gone.
                                             The ONE badge on this row that is not neutral gray, and the
                                             only one that reports a LOSS rather than a state, so it is
                                             red and it leads. Still a BADGE, NEVER A COLOUR: the agent
                                             is doing exactly what it was doing, having heard nothing, so
                                             the dot keeps telling the truth about the work. It clears
                                             when a prompt actually lands, never on a click. -->
                                        <Border Background="#33DC4444"
                                                CornerRadius="6"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0"
                                                IsVisible="{Binding HasUndeliveredPrompt}"
                                                ToolTip.Tip="{Binding UndeliveredPromptTooltip}">
                                            <TextBlock Text="NOT DELIVERED"
                                                       Foreground="#F08A8A"
                                                       FontSize="9"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <!-- Winding-down badge (defect 23): the session is flagged for
                                             deletion and the reaper will remove it shortly. A BADGE,
                                             NEVER A COLOUR (owner's ruling, 14 July 2026): pending
                                             deletion says nothing about what the agent is DOING, and a
                                             flagged session may still be working - so the status dot
                                             keeps telling the truth (blue while it works) and this rides
                                             beside it. Muted neutral gray like the role glyph, never a
                                             status color; the tooltip carries the reason. -->
                                        <Border Background="{DynamicResource ButtonBackground}"
                                                CornerRadius="6"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0"
                                                IsVisible="{Binding IsPendingDeletion}"
                                                ToolTip.Tip="{Binding PendingDeletionTooltip}">
                                            <TextBlock Text="WINDING DOWN"
                                                       Foreground="#9CA3AF"
                                                       FontSize="9"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <!-- Snooze-ended badge: this session came back ON ITS OWN because its
                                             snooze timer fired (SessionDto.SnoozeExpired, folded by the
                                             Gateway and stamped down). The dot is already red "Needs you" -
                                             the fold puts an expired snooze straight back into needs-you - so
                                             this badge only annotates WHY it returned: a "go see why it went
                                             quiet" item, not a fresh turn-end. Neutral gray like the other
                                             badges, never a status colour; it never competes with the dot. -->
                                        <Border Background="{DynamicResource ButtonBackground}"
                                                CornerRadius="6"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0"
                                                IsVisible="{Binding IsSnoozeEnded}"
                                                ToolTip.Tip="Snooze ended - this session came back on its own and is still waiting on you">
                                            <TextBlock Text="SNOOZE ENDED"
                                                       Foreground="#9CA3AF"
                                                       FontSize="9"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <!-- Agent badge: which CLI this session is running AND which model
                                             it is running (issue internal#1340) - one badge, because they
                                             are one identity and the rail has no room for two. The model
                                             half is the recorded id shortened (the badge already says
                                             "Claude Code", so a leading "claude-" is dropped); the full id
                                             is in the tooltip. When there is no model the words say WHICH
                                             absence it is - "no model yet" for a session that has not
                                             finished a turn, "model not reported" for an agent that can
                                             never report one - and never a blank, which would read as a
                                             fact this rail failed to fetch. Every string here comes from
                                             ModelDisplayFold, the same fold the Gateway stamps for the
                                             browser clients; the rail composes none of them. -->
                                        <Border Background="{Binding AgentBadgeBrush}"
                                                CornerRadius="6"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0"
                                                ToolTip.Tip="{Binding AgentModelTooltip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding AgentLabel}"
                                                           Foreground="White"
                                                           FontSize="9"
                                                           FontWeight="SemiBold" />
                                                <!-- The divider is part of the badge, not a colour of its
                                                     own: same white, held back so the eye reads two halves
                                                     of one pill rather than two badges jammed together. -->
                                                <TextBlock Text="|"
                                                           Foreground="White"
                                                           Opacity="0.5"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Margin="4,0" />
                                                <TextBlock Text="{Binding ModelLabel}"
                                                           Foreground="White"
                                                           Opacity="{Binding ModelOpacity}"
                                                           FontSize="9"
                                                           FontWeight="Normal" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <!-- LINE 3: live state. The changes badge is anchored
                                         to the RIGHT edge so it is always visible even if
                                         activity/waiting text grows. -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <!-- A WRAP PANEL, NOT A HORIZONTAL STACK (the Wingman-on-every-turn
                                             mission, slice D). The label is the Gateway's folded words, and a
                                             Wingman verdict label runs to eighty characters. A horizontal stack
                                             measures its children with unlimited width, so a long label was laid
                                             out on one line and cut off at the rail's edge; in a wrap panel the
                                             label wraps inside the column and the wait and wake times flow after
                                             it. SessionRailVerdictLabelRenderTests renders this row at the
                                             rail's real width with the longest label and fails if it clips. -->
                                        <WrapPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding ActivityLabel}"
                                                       Foreground="#888888"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <!-- How long a needs-you session has been waiting,
                                                 so you can triage the most stale one first.
                                                 Only shown when red. -->
                                            <TextBlock Text="{Binding WaitingDurationLabel}"
                                                       IsVisible="{Binding HasWaitingDuration}"
                                                       Foreground="#E0883C"
                                                       FontSize="11"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center" />
                                            <!-- How long until an armed snooze wakes this session ("wakes in
                                                 3h 48m"), shown beside the "Snoozed" label. The Gateway owns
                                                 the clock (SessionDto.SnoozeUntil, stamped down); the rail
                                                 only renders the countdown. Muted, never a status colour. -->
                                            <TextBlock Text="{Binding HoldTimeLabel}"
                                                       IsVisible="{Binding HasHoldTime}"
                                                       Foreground="#888888"
                                                       FontSize="11"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </WrapPanel>
                                        <Border Grid.Column="1"
                                                IsVisible="{Binding HasUncommittedChanges}"
                                                Background="#6B4C00"
                                                CornerRadius="6"
                                                Padding="4,0"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Foreground="#F5D060" FontSize="9"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} chg">
                                                        <Binding Path="UncommittedCount" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                    <!-- LINE 3b: THE ROW LINE (Message Load mission, slice 4). What waits
                                         in this session's fleet inbox, in the Gateway's words, rendered
                                         verbatim - "2 messages waiting". Present only when something waits.
                                         Message-count blue from the style guide; one colour for every line,
                                         because the words, not the rail, say what kind of wait it is. -->
                                    <TextBlock Text="{Binding InboxLine}"
                                               IsVisible="{Binding HasInboxLine}"
                                               Foreground="#3B82F6"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                    <!-- LINE 4: THE CREW LINE. Present only while this crew is CLOSED,
                                         which is the whole point of it - a collapsed crew must hide
                                         nothing that matters, and when the crew is open its sessions
                                         are rows of their own saying the same thing in full.

                                         One square per session under it AT EVERY LEVEL, in the crew's
                                         own order and each in that session's own stamped colour, so
                                         collapsing hides no colour. Then the counts, worded once by the
                                         shared fold. Then the age of the crew's oldest session, at the
                                         right, ticking on the rail's existing timer.

                                         The need-you count is ZERO for every live crew (issue #2826 -
                                         a child with a live supervisor never goes red) and turns
                                         non-zero only when the supervisor dies and its sessions
                                         surface. That is exactly when it must be seen, so it is always
                                         carried and never dropped when zero. -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0"
                                          IsVisible="{Binding ShowCrewLine}">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding CrewLineText}"
                                                   Foreground="#9DB4DD"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CrewAgeText}"
                                                   Foreground="#888888"
                                                   FontSize="11"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <!-- LINE 5: THE STRIP OF SQUARES, on its OWN line under the counts.
                                         The drawn design puts it beside them, but it was drawn at 545
                                         pixels and this rail opens at 264 (MainLayoutGrid's first
                                         column). Beside the counts, nine squares and their gaps take 88
                                         of about 230 usable pixels and the COUNTS are what gets trimmed
                                         - which reads as broken, and they are the part that answers
                                         "do I need to open this crew?".

                                         Architect's ruling, 15 September 2026: give the strip its own
                                         line. Do NOT cap it - every session under a crew keeping a
                                         square is an explicit design promise - and do not drop the age,
                                         which is the only thing saying how long the crew has run. The
                                         cost is one row of height, on closed crews only. -->
                                    <ItemsControl ItemsSource="{Binding CrewColorBrushes}"
                                                  IsVisible="{Binding ShowCrewLine}"
                                                  Margin="0,3,0,0"
                                                  HorizontalAlignment="Left">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <!-- Wrapping, not clipping: a crew large enough to run
                                                     past the rail's width takes a second row of squares
                                                     rather than losing the sessions off the end. -->
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="8" Height="8" CornerRadius="2"
                                                        Margin="0,0,2,2"
                                                        Background="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Collapsed sidebar: a slim strip that keeps the at-a-glance status
                 dots (clickable, tooltip = session name) and the expand button.
                 Toggled with SidebarFullPanel from code-behind. -->
            <DockPanel x:Name="SidebarSlimPanel" IsVisible="False">
                <!-- Expand back to the full panel. Chevron points right, pulling the
                     panel out from the left edge. -->
                <Button DockPanel.Dock="Top"
                        Click="SidebarExpand_Click"
                        Focusable="False"
                        Margin="2,6,2,4"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Expand the session panel"
                        Classes="panelToggle">
                    <Viewbox Width="8" Height="12">
                        <Path Data="M 3,2 L 7,7 L 3,12"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Viewbox>
                </Button>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SlimSessionList" Margin="0,2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="SlimSessionDot_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,3"
                                        HorizontalAlignment="Center"
                                        Cursor="Hand"
                                        Classes="slimDot"
                                        ToolTip.Tip="{Binding DisplayName}">
                                    <Border Width="18" Height="18"
                                            CornerRadius="5"
                                            BorderThickness="1"
                                            BorderBrush="Transparent"
                                            Background="{Binding StatusColorBrush}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
            </Grid>
        </Border>

        <!-- Grid splitter (disabled while the sidebar is collapsed) -->
        <GridSplitter x:Name="SidebarSplitter"
                      Grid.Column="1" Grid.RowSpan="2"
                      Width="3"
                      Background="#3C3C3C"
                      ResizeDirection="Columns" />

        <!-- ==================== TOP BAR (unified, always visible) ====================
             One bar holds BOTH the global tools (right) and the per-session identity
             (fill). These used to be two separate, overlapping borders in the same
             grid cell, so the opaque blue session banner painted right over the
             Settings button. Now the global tools always render; only the identity
             grid toggles. The blue accent background is applied in code-behind when a
             session is active (SetSessionHeaderVisible). -->
        <Border x:Name="TopBar"
                Grid.Row="0" Grid.Column="2"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="#3C3C3C" BorderThickness="0,0,0,1"
                MinHeight="36">
            <DockPanel Margin="12,6">
                <!-- Global tools (Settings, Claude/MCP/Agents config, Help) moved to
                     the window menu bar and toolbar. This bar now carries only the
                     per-session identity. -->

                <!-- Per-session identity (fill). Toggled via SessionHeaderBanner in code.
                     The Director address moved to the app-wide toolbar (it identifies the
                     whole application, not the selected session). -->
                <Grid x:Name="SessionHeaderBanner"
                      RowDefinitions="Auto,Auto"
                      IsVisible="False">
                <!-- Row 0: Session name + badges + buttons -->
                <DockPanel Grid.Row="0">
                    <!-- Right-aligned buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Spacing="4">
                        <!-- Activity label -->
                        <TextBlock x:Name="HeaderActivityLabel"
                                   Text=""
                                   Foreground="#FFFFFFCC"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   IsVisible="False"
                                   Margin="0,0,8,0" />
                    </StackPanel>

                    <!-- Session name -->
                    <TextBlock x:Name="HeaderSessionName"
                               Text=""
                               Foreground="White"
                               FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <!-- Agent + model badge for the SELECTED session (issue internal#1340). The rail says
                         it for every row; this says it for the one on screen, so the answer to "what is
                         this session running" is on the screen you are actually looking at. Same fold, same
                         words, same tooltip as the rail - set in code-behind beside the name, because this
                         banner is code-driven rather than bound. -->
                    <Border x:Name="HeaderAgentModelBadge"
                            Background="#1E40AF"
                            CornerRadius="4"
                            Padding="8,3"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            IsVisible="False">
                        <TextBlock x:Name="HeaderAgentModelText"
                                   Text=""
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                    <!-- Message count badge -->
                    <Border x:Name="HeaderMessageCountBadge"
                            Background="#1E40AF"
                            CornerRadius="4"
                            Padding="8,3"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            IsVisible="False">
                        <TextBlock x:Name="HeaderMessageCountText"
                                   Text="0 msgs"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                </DockPanel>

                <!-- Row 1: GitHub remote links (only for GitHub Actions sessions) -->
                <StackPanel x:Name="HeaderRemoteLinks" Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,4,0,0"
                            IsVisible="False">
                    <TextBlock Text="Remote:"
                               Foreground="#87CEFA" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="HeaderRemoteRepo"
                               Text=""
                               Foreground="#E0E0E0" FontSize="10"
                               FontFamily="Cascadia Mono,Consolas,monospace"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="BtnOpenRemoteThread"
                            Content="Open thread"
                            Click="BtnOpenRemoteThread_Click"
                            Padding="6,2" FontSize="10"
                            Background="#005A9E" Foreground="#E0E0E0"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"
                            ToolTip.Tip="Open the GitHub issue/PR thread driving this session" />
                    <Button x:Name="BtnOpenRemoteActions"
                            Content="Open Actions"
                            Click="BtnOpenRemoteActions_Click"
                            Padding="6,2" FontSize="10"
                            Background="#005A9E" Foreground="#E0E0E0"
                            BorderThickness="0" Cursor="Hand"
                            ToolTip.Tip="Open the repository's GitHub Actions runs" />
                </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ==================== MAIN CONTENT + RIGHT PANEL ==================== -->
        <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,Auto">

            <!-- Left: Terminal + Prompt -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto">

                <!-- Left tab bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SidebarBackground}"
                        Padding="8,0"
                        Height="36">
                    <DockPanel>
                        <!-- Right-aligned capture + refresh buttons -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Spacing="2">
                            <Button x:Name="TabBarCaptureButton"
                                    Content="Capture"
                                    Click="TabBarCaptureButton_Click"
                                    Background="Transparent"
                                    Foreground="#888888"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="8,4"
                                    FontSize="11"
                                    ToolTip.Tip="Capture terminal diagnostic snapshot (Ctrl+Shift+F12)"
                                    IsVisible="False" />
                            <Button x:Name="TabBarRefreshButton"
                                    Content="Reset View"
                                    Click="TabBarRefreshButton_Click"
                                    Background="Transparent"
                                    Foreground="#888888"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="8,4"
                                    FontSize="11"
                                    ToolTip.Tip="Rebuild terminal and scrollbar from PTY buffer"
                                    IsVisible="False" />
                            <!-- Open THIS session in the Cockpit (owner ruling 2026-09-19). It is the LAST
                                 item in this right-docked group on purpose: Capture and Reset View above are
                                 shown only on the Terminal tab, so a button placed before them would slide
                                 sideways every time the tab changes. Pinned to the right edge it holds one
                                 spot, which is the whole reason it lives on this row rather than on the blue
                                 session header, whose contents come and go.
                                 It is also shown with the SESSION rather than the tab, so it is there on
                                 Source Control too - again, one spot.
                                 Drawn as a filled, rounded, bordered button rather than a flat square one:
                                 the tabs to its left are flat and square, and this must not read as a tab. -->
                            <Button x:Name="TabBarCockpitButton"
                                    Content="Cockpit &#x2197;"
                                    Click="TabBarCockpitButton_Click"
                                    Background="#0D9488"
                                    BorderBrush="#14B8A6"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Foreground="White"
                                    Cursor="Hand"
                                    Padding="10,4"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Margin="6,0,0,0"
                                    ToolTip.Tip="Open this session in the Cockpit"
                                    IsVisible="False">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#0F766E" />
                                        <Setter Property="BorderBrush" Value="#2DD4BF" />
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <Button x:Name="TerminalTabButton"
                                    Content="Terminal"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="White"
                                    Padding="12,4"
                                    FontSize="12"
                                    Click="TerminalTabButton_Click" />
                            <Button x:Name="SourceControlTabButton"
                                    Content="Source Control"
                                    Background="Transparent"
                                    Foreground="#888888"
                                    Padding="12,4"
                                    FontSize="12"
                                    Click="SourceControlTabButton_Click" />
                            <!-- Orphaned-worktree count: the red dot that sits on the Source Control tab -->
                            <Border x:Name="SourceControlOrphanBadge"
                                    Background="#EF4444"
                                    CornerRadius="8"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    IsVisible="False"
                                    ToolTip.Tip="Worktrees safe to reap">
                                <TextBlock x:Name="SourceControlOrphanBadgeText"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="9"
                                           FontWeight="SemiBold" />
                            </Border>
                            <!-- Separator between fixed tabs and document tabs -->
                            <Border x:Name="DocTabSeparator"
                                    Width="1" Height="16"
                                    Background="#3C3C3C"
                                    Margin="4,0"
                                    IsVisible="False" />

                            <!-- Dynamic document tab buttons inserted here -->
                            <ItemsControl x:Name="DocumentTabBar"
                                          IsVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- Close All document tabs button -->
                            <Button x:Name="CloseAllDocsButton"
                                    Content="x"
                                    Background="Transparent"
                                    Foreground="#666666"
                                    Padding="6,4"
                                    FontSize="10"
                                    ToolTip.Tip="Close all document tabs"
                                    IsVisible="False"
                                    Click="CloseAllDocsButton_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Left tab content area -->
                <Panel Grid.Row="1" Background="#1E1E1E">

                    <!-- Terminal panel -->
                    <Panel x:Name="TerminalPanel" IsVisible="True">
                        <!-- Placeholder when no session -->
                        <TextBlock x:Name="PlaceholderText"
                                   Text="Select or create a session to begin"
                                   Foreground="#555555"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <Grid x:Name="TerminalDock" IsVisible="False">
                            <!-- Terminal + scrollbar fill the whole area -->
                            <Grid x:Name="TerminalGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <!-- Fixed gutter, NOT Auto: hiding/showing the scrollbar must
                                         never change the terminal's width. With Auto, the bar
                                         becoming visible when scrollback first appeared stole
                                         columns mid-session and forced the agent to re-wrap
                                         (issue #1307). -->
                                    <ColumnDefinition Width="14" />
                                </Grid.ColumnDefinitions>
                                <terminal:TerminalControl x:Name="TerminalHost"
                                                          Grid.Column="0" />
                                <ScrollBar x:Name="TerminalScrollBar" Grid.Column="1"
                                           Orientation="Vertical"
                                           Width="14"
                                           Background="#1E1E1E"
                                           Foreground="#5A5A5A"
                                           AllowAutoHide="False"
                                           Opacity="1" />
                            </Grid>
                        </Grid>
                    </Panel>

                    <!-- Source Control panel -->
                    <Panel x:Name="SourceControlPanel" IsVisible="False">
                        <controls:SourceControlView x:Name="SourceControlView" />
                    </Panel>

                    <!-- Document viewer panel (dynamic content swapped per tab) -->
                    <Panel x:Name="DocumentPanel" IsVisible="False" />
                </Panel>

                <!-- ==================== NOTIFICATION BAR ==================== -->
                <Border x:Name="NotificationBar" Grid.Row="2"
                        Background="{DynamicResource SidebarBackground}"
                        BorderBrush="#3C3C3C" BorderThickness="0,1,0,0"
                        Padding="8,4"
                        IsVisible="False">
                    <StackPanel Spacing="5">
                        <DockPanel>
                            <TextBlock x:Name="NotificationIcon" DockPanel.Dock="Left"
                                       Text="(i)"
                                       Foreground="#3B82F6"
                                       FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       IsVisible="False" />
                            <TextBlock x:Name="NotificationText"
                                       Text=""
                                       Foreground="{DynamicResource TextForeground}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <!-- Download progress (auto-update). Hidden for plain notifications. -->
                        <ProgressBar x:Name="NotificationProgress"
                                     Height="6" Minimum="0" Maximum="100" Value="0"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="#1E1E1E"
                                     IsVisible="False" />
                        <TextBlock x:Name="NotificationProgressMeta"
                                   Text=""
                                   FontSize="10" Foreground="#888888"
                                   FontFamily="Cascadia Mono,Consolas,monospace"
                                   IsVisible="False" />
                    </StackPanel>
                </Border>

                <!-- ==================== PROMPT BAR ==================== -->
                <Border Grid.Row="3"
                        x:Name="PromptBarBorder"
                        Background="{DynamicResource SidebarBackground}"
                        BorderBrush="#3C3C3C" BorderThickness="0,1,0,0"
                        Padding="8,6"
                        IsVisible="False">
                  <StackPanel Spacing="6">
                    <!-- Driver-capability action buttons (Stop / Interrupt / Clear
                         context / History) - rendered from the active session's
                         agent-driver flags, see Controls/SessionActionBar. -->
                    <controls:SessionActionBar x:Name="ActionBar" />
                    <Panel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="PromptInput"
                                     Grid.Column="0"
                                     Watermark="Type a message here, then press Ctrl+Enter to send it into the terminal (Ctrl+Shift+Enter to queue it).&#10;&#10;This box lives outside the terminal, so you can write slowly, or dictate with Speak (Ctrl+H) - and it can be driven remotely from your phone or the web."
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="98"
                                     MaxHeight="200"
                                     Background="#1E1E1E"
                                     Foreground="{DynamicResource TextForeground}"
                                     BorderBrush="#3C3C3C"
                                     Padding="8,6"
                                     FontFamily="Cascadia Mono,Consolas,monospace"
                                     FontSize="13"
                                     DragDrop.AllowDrop="True" />

                            <!-- Expand into the large editor + image preview. Overlaid in the
                                 top-right corner of the input so it adds no button-bar clutter. -->
                            <Button x:Name="PromptExpandButton"
                                    Grid.Column="0"
                                    Content="Expand"
                                    Click="PromptExpand_Click"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,4,6,0"
                                    Padding="6,2"
                                    FontSize="10"
                                    Background="#2D2D30"
                                    Foreground="#AAAAAA"
                                    BorderThickness="0"
                                    Opacity="0.85"
                                    Cursor="Hand"
                                    ToolTip.Tip="Open the large editor with image preview (text + pictures)" />

                            <!-- Vertical action stack: Send (primary) on top, then
                                 Speak, then Queue. Handover is alpha-gated and stays
                                 collapsed unless enabled, so the visible stack is three
                                 buttons tall - matching PromptInput's height. Fixed
                                 width/height per button so the bar can't grow when
                                 PromptInput expands. -->
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        Margin="8,0,0,0"
                                        Spacing="4">
                                <Button x:Name="BtnSend"
                                        Content="Send"
                                        Width="80" Height="30"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="White"
                                        HorizontalContentAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Click="BtnSend_Click" />
                                <Button x:Name="BtnSpeak"
                                        Content="Speak"
                                        Width="80" Height="30"
                                        Background="#16A34A"
                                        Foreground="White"
                                        HorizontalContentAlignment="Center"
                                        FontSize="13"
                                        Click="BtnSpeak_Click"
                                        ToolTip.Tip="Dictate a message - press Ctrl+H from anywhere on the Terminal tab to open this" />
                                <Button x:Name="BtnQueuePrompt"
                                        Content="Queue"
                                        Width="80" Height="30"
                                        Background="{DynamicResource ButtonBackground}"
                                        Foreground="{DynamicResource TextForeground}"
                                        HorizontalContentAlignment="Center"
                                        FontSize="13"
                                        Click="BtnQueuePrompt_Click"
                                        ToolTip.Tip="Add to prompt queue (Ctrl+Shift+Enter)" />
                                <Button x:Name="BtnHandover"
                                        Content="Handover"
                                        Width="80" Height="30"
                                        Background="#2D2D30"
                                        Foreground="#AAAAAA"
                                        HorizontalContentAlignment="Center"
                                        FontSize="13"
                                        Click="BtnHandover_Click"
                                        ToolTip.Tip="Create a handover document for this session" />
                            </StackPanel>
                        </Grid>

                        <!-- Slash command autocomplete popup -->
                        <Popup x:Name="SlashCommandPopup"
                               PlacementTarget="{Binding #PromptInput}"
                               Placement="Top"
                               IsLightDismissEnabled="False">
                            <Border Background="#252526"
                                    BorderBrush="#3C3C3C"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    MinWidth="700"
                                    MaxWidth="900"
                                    MaxHeight="420">
                                <Grid ColumnDefinitions="260,1,*">

                                    <!-- Command list -->
                                    <ListBox x:Name="SlashCommandList"
                                             Grid.Column="0"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             MaxHeight="410"
                                             Tapped="SlashCommandList_Tapped"
                                             SelectionChanged="SlashCommandList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,2">
                                                    <TextBlock Text="{Binding Name, StringFormat=/\{0\}}"
                                                               Foreground="White"
                                                               FontFamily="Cascadia Mono,Consolas,monospace"
                                                               FontSize="13" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Foreground="#888888"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,1,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Divider -->
                                    <Border Grid.Column="1" Background="#3C3C3C" />

                                    <!-- Documentation panel -->
                                    <ScrollViewer Grid.Column="2"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="SlashCommandDocPanel" Margin="12,8"
                                                    IsVisible="False">
                                            <TextBlock x:Name="SlashCommandDocTitle"
                                                       Foreground="White"
                                                       FontFamily="Cascadia Mono,Consolas,monospace"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Margin="0,0,0,4" />
                                            <TextBlock x:Name="SlashCommandDocSource"
                                                       Foreground="#4EC9B0"
                                                       FontSize="11"
                                                       Margin="0,0,0,6" />
                                            <TextBlock x:Name="SlashCommandDocDesc"
                                                       Foreground="{DynamicResource TextForeground}"
                                                       FontSize="12" TextWrapping="Wrap"
                                                       Margin="0,0,0,8" />
                                            <Border Background="#1E1E1E"
                                                    CornerRadius="3"
                                                    Padding="10,8">
                                                <TextBlock x:Name="SlashCommandDocBody"
                                                           Foreground="#D4D4D4"
                                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                                           FontSize="11.5" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>
                    </Panel>
                  </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== RIGHT PANEL ==================== -->
            <Border x:Name="RightPanel"
                    Grid.Column="1"
                    Width="280"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="#3C3C3C" BorderThickness="1,0,0,0">

              <Grid>
                <!-- Collapse chevron at the TOP-RIGHT of the panel header, mirroring the
                     session rail's toggle. Points right (tuck into the right edge). -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,3,6,0"
                        ZIndex="5"
                        Classes="panelToggle"
                        Click="RightPanelToggle_Click"
                        ToolTip.Tip="Collapse the right panel">
                    <Viewbox Width="8" Height="12">
                        <Path Data="M 3,2 L 7,7 L 3,12"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Viewbox>
                </Button>

                <TabControl x:Name="RightPanelTabs"
                            Background="Transparent"
                            Padding="0"
                            FontSize="11">
                    <TabControl.Styles>
                        <Style Selector="TabItem">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="MinHeight" Value="28" />
                        </Style>
                    </TabControl.Styles>

                    <!-- ===== Screenshots Tab ===== -->
                    <TabItem Header="Screenshots">
                        <DockPanel>
                            <!-- Top bar -->
                            <Border DockPanel.Dock="Top" Padding="8,6"
                                    BorderBrush="#3C3C3C" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <Button Content="Clear All" DockPanel.Dock="Right"
                                            Click="BtnClearScreenshots_Click"
                                            Background="Transparent" Foreground="#888888"
                                            BorderThickness="0" FontSize="11" Cursor="Hand"
                                            Padding="6,2" Margin="4,0,0,0" />
                                    <Button Content="Refresh" DockPanel.Dock="Right"
                                            Click="BtnRefreshScreenshots_Click"
                                            Background="Transparent" Foreground="#888888"
                                            BorderThickness="0" FontSize="11" Cursor="Hand"
                                            Padding="6,2" />
                                    <TextBlock Text="SCREENSHOTS"
                                               Foreground="#888888" FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <!-- Screenshot list -->
                            <ListBox x:Name="ScreenshotList"
                                     Background="Transparent"
                                     Padding="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4" Margin="0,2"
                                                Background="#2A2A2A" CornerRadius="4"
                                                PointerPressed="ScreenshotItem_PointerPressed">
                                            <StackPanel>
                                                <Image Source="{Binding Thumbnail}"
                                                       MaxHeight="160"
                                                       Stretch="Uniform" />
                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding TimeLabel}"
                                                               Foreground="#888888" FontSize="10"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right"
                                                                Spacing="4">
                                                        <Button Content="View"
                                                                Tag="{Binding FilePath}"
                                                                Click="ScreenshotView_Click"
                                                                Background="Transparent"
                                                                Foreground="#CCCCCC"
                                                                BorderThickness="0"
                                                                FontSize="10" Cursor="Hand"
                                                                Padding="4,2" />
                                                        <Button Content="Copy"
                                                                Tag="{Binding FilePath}"
                                                                Click="ScreenshotCopy_Click"
                                                                ToolTip.Tip="Copy image to clipboard"
                                                                Background="Transparent"
                                                                Foreground="#CCCCCC"
                                                                BorderThickness="0"
                                                                FontSize="10" Cursor="Hand"
                                                                Padding="4,2" />
                                                        <Button Content="Issue"
                                                                Tag="{Binding FilePath}"
                                                                Click="ScreenshotCreateIssue_Click"
                                                                ToolTip.Tip="Create GitHub issue with this screenshot"
                                                                Background="Transparent"
                                                                Foreground="#CCCCCC"
                                                                BorderThickness="0"
                                                                FontSize="10" Cursor="Hand"
                                                                Padding="4,2" />
                                                        <Button Content="Del"
                                                                Tag="{Binding FilePath}"
                                                                Click="ScreenshotDelete_Click"
                                                                Background="Transparent"
                                                                Foreground="#CC4444"
                                                                BorderThickness="0"
                                                                FontSize="10" Cursor="Hand"
                                                                Padding="4,2" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>

                    <!-- ===== Queue Tab ===== -->
                    <TabItem x:Name="QueueTab" Header="Queue">
                        <DockPanel>
                            <!-- Top bar -->
                            <Border DockPanel.Dock="Top" Padding="8,6"
                                    BorderBrush="#3C3C3C" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <Button Content="Clear" DockPanel.Dock="Right"
                                            Click="BtnClearQueue_Click"
                                            Background="Transparent" Foreground="#888888"
                                            BorderThickness="0" FontSize="11" Cursor="Hand"
                                            Padding="6,2" />
                                    <TextBlock x:Name="QueueCountText"
                                               Text="0 items"
                                               Foreground="#888888" FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <!-- Empty state -->
                            <TextBlock x:Name="QueueEmptyText"
                                       Text="No queued prompts"
                                       Foreground="#555555" FontSize="12"
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                            <!-- Queue items list -->
                            <ListBox x:Name="QueueItemsList"
                                     Background="Transparent"
                                     Padding="4"
                                     IsVisible="False"
                                     DoubleTapped="QueueItemsList_DoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,4" Margin="0,1"
                                                Background="#2A2A2A" CornerRadius="2">
                                            <Grid ColumnDefinitions="20,*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Index}"
                                                           Foreground="#666666" FontSize="11"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Preview}"
                                                           Foreground="#CCCCCC" FontSize="11"
                                                           TextWrapping="Wrap" MaxHeight="80"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding FullText}"
                                                           ToolTip.ShowDelay="300"
                                                           ToolTip.Placement="Left" />
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Vertical"
                                                            Spacing="1"
                                                            VerticalAlignment="Top">
                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                        <Button Content="/\"
                                                                Tag="{Binding Id}"
                                                                Click="QueueItemMoveUp_Click"
                                                                Background="Transparent"
                                                                Foreground="#888888"
                                                                BorderThickness="0"
                                                                FontSize="9" Cursor="Hand"
                                                                Padding="3,1"
                                                                ToolTip.Tip="Move up" />
                                                        <Button Content="\/"
                                                                Tag="{Binding Id}"
                                                                Click="QueueItemMoveDown_Click"
                                                                Background="Transparent"
                                                                Foreground="#888888"
                                                                BorderThickness="0"
                                                                FontSize="9" Cursor="Hand"
                                                                Padding="3,1"
                                                                ToolTip.Tip="Move down" />
                                                        <Button Content="Edit"
                                                                Tag="{Binding Id}"
                                                                Click="QueueItemEdit_Click"
                                                                Background="Transparent"
                                                                Foreground="#3B82F6"
                                                                BorderThickness="0"
                                                                FontSize="10" Cursor="Hand"
                                                                Padding="4,2"
                                                                ToolTip.Tip="Open in the review editor (text + image preview)" />
                                                        <Button Content="Pop"
                                                                Tag="{Binding Id}"
                                                                Click="QueueItemPop_Click"
                                                                Background="Transparent"
                                                                Foreground="#22C55E"
                                                                BorderThickness="0"
                                                                FontSize="10" Cursor="Hand"
                                                                Padding="4,2" />
                                                        <Button Content="X"
                                                                Tag="{Binding Id}"
                                                                Click="QueueItemRemove_Click"
                                                                Background="Transparent"
                                                                Foreground="#CC4444"
                                                                BorderThickness="0"
                                                                FontSize="10" FontWeight="Bold"
                                                                Cursor="Hand" Padding="4,2" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>

                </TabControl>
              </Grid>
            </Border>

            <!-- Collapsed right panel: a thin strip on the right edge with the expand
                 chevron at the TOP (mirrors the session rail's slim strip). Shown instead
                 of the full panel when collapsed; the Auto column sizes to whichever is up. -->
            <Border x:Name="RightPanelCollapsedStrip"
                    Grid.Column="1"
                    Width="22"
                    IsVisible="False"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="#3C3C3C" BorderThickness="1,0,0,0">
                <Button VerticalAlignment="Top" HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Classes="panelToggle"
                        Click="RightPanelToggle_Click"
                        ToolTip.Tip="Expand the right panel">
                    <Viewbox Width="8" Height="12">
                        <Path Data="M 7,2 L 3,7 L 7,12"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Viewbox>
                </Button>
            </Border>
        </Grid>

        <!-- ==================== COMMS OVERLAY (covers main + right panel) ==================== -->
        <Border x:Name="CommsOverlay"
                Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                Background="{DynamicResource PanelBackground}"
                ZIndex="10"
                IsVisible="False">
            <DockPanel>
                <!-- Header bar -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource SidebarBackground}"
                        BorderBrush="#3C3C3C" BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <DockPanel>
                        <Button x:Name="BtnCommsClose"
                                DockPanel.Dock="Right"
                                Content="[x] Close"
                                Click="BtnCommsClose_Click"
                                Background="Transparent"
                                Foreground="#888888"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="8,4"
                                FontSize="12" />
                        <TextBlock Text="Communication Manager"
                                   Foreground="{DynamicResource TextForeground}"
                                   FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- CommManagerView fills the rest -->
                <commMgr:CommManagerView x:Name="CommManagerView" />
            </DockPanel>
        </Border>

        <!-- ==================== CONNECTIONS OVERLAY (covers main + right panel) ==================== -->
        <Border x:Name="ConnectionsOverlay"
                Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                Background="{DynamicResource PanelBackground}"
                ZIndex="10"
                IsVisible="False">
            <DockPanel>
                <!-- Header bar -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource SidebarBackground}"
                        BorderBrush="#3C3C3C" BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <DockPanel>
                        <Button x:Name="BtnConnectionsClose"
                                DockPanel.Dock="Right"
                                Content="[x] Close"
                                Click="BtnConnectionsClose_Click"
                                Background="Transparent"
                                Foreground="#888888"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="8,4"
                                FontSize="12" />
                        <TextBlock Text="Browser Connections"
                                   Foreground="{DynamicResource TextForeground}"
                                   FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- ConnectionsView fills the rest -->
                <controls:ConnectionsView x:Name="ConnectionsView" />
            </DockPanel>
        </Border>

        <!-- Repositories overlay: the pinned, non-modal repository/worktree home over the center
             content (issue #507, phase 4). Leaves the session rail (column 0) clickable. -->
        <Border x:Name="RepositoriesOverlay"
                Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                Background="{DynamicResource PanelBackground}"
                ZIndex="10"
                IsVisible="False">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource SidebarBackground}"
                        BorderBrush="#3C3C3C" BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <DockPanel>
                        <Button x:Name="BtnRepositoriesClose"
                                DockPanel.Dock="Right"
                                Content="[x] Close"
                                Click="BtnRepositoriesClose_Click"
                                Background="Transparent"
                                Foreground="#888888"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="8,4"
                                FontSize="12" />
                        <TextBlock Text="Repositories"
                                   Foreground="{DynamicResource TextForeground}"
                                   FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <controls:RepositoriesView x:Name="RepositoriesView" />
            </DockPanel>
        </Border>

        <!-- The Tools catalog is no longer a standalone in-window overlay: it now lives as the
             Tools tab inside the Settings dialog (one screen, status + repair together). The
             toolbar "Tools" button and the rail tools indicator both open Settings on that tab. -->

        <!-- ==================== PASTE-REMINDER CARD ====================
             Floating card shown after "create GitHub issue from screenshot" opens
             the browser: the screenshot is waiting on the clipboard for a manual
             Ctrl+V (no application is allowed to paste into a browser page itself,
             so this is the unavoidable manual step). Auto-hides after a while;
             the X dismisses it immediately. -->
        <Border x:Name="PasteCard"
                Grid.Row="1" Grid.Column="2"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                MaxWidth="400"
                Background="#252526"
                BorderBrush="#007ACC" BorderThickness="1"
                CornerRadius="6"
                ZIndex="20"
                IsVisible="False">
            <DockPanel Margin="14,10,8,12">
                <Button DockPanel.Dock="Right"
                        Content="X"
                        Click="PasteCardClose_Click"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        Foreground="#888888"
                        BorderThickness="0"
                        FontSize="11" Cursor="Hand"
                        Padding="6,2" />
                <StackPanel Spacing="4" Margin="0,0,8,0">
                    <TextBlock x:Name="PasteCardTitle"
                               Foreground="#CCCCCC"
                               FontSize="13" FontWeight="Bold" />
                    <TextBlock x:Name="PasteCardBody"
                               Foreground="#AAAAAA"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== STATUS / HOME ====================
             Status screen shown in the MAIN CONTENT cell (row 1, column 2) when no session
             is selected, or on demand via View > Status. The window chrome - toolbar and the
             session rail (with the gateway light at its bottom) - stays visible around it.
             It overlays the terminal content (higher ZIndex) and has an opaque background. -->
        <controls:HomeView x:Name="HomeView"
                           Grid.Row="1" Grid.Column="2"
                           ZIndex="30"
                           IsVisible="False" />

    </Grid>
    </DockPanel>
</Window>
