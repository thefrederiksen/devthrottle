<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>CcDirector.TurnRuleScorer</RootNamespace>
    <AssemblyName>CcDirector.TurnRuleScorer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The scorer's own reading, splitting and tallying are tested like any other code. The rule
         it asks is tested next door in ContentTurnRuleTests; these cover the parts that are this
         tool's - the hash gate, the body-split guess, and the census that keeps an empty capture
         from reading as a verdict. -->
    <InternalsVisibleTo Include="CcDirector.Core.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- THE SHIPPED RULE ITSELF, and nothing that re-states it. This tool constructs
         TerminalContentNovelty's real rule objects through ITerminalNoveltyRule and
         ITerminalSizeRule - the same objects TerminalStateDetector holds - and asks them. A scorer
         that re-implemented the rule in its own code, or in another language, would prove something
         about the copy and nothing about what runs on the owner's machine. That was a finding in
         round one of the phase-one inspection, and it is why the two interfaces exist at all. -->
    <ProjectReference Include="..\CcDirector.Core\CcDirector.Core.csproj" />
  </ItemGroup>

</Project>
