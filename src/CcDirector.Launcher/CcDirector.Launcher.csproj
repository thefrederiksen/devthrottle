<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Multi-target (cc-launcher mission): net10.0-windows is the shipped Windows build,
         plain net10.0 is the macOS build (published osx-arm64 as cc-launcher-mac-arm64). -->
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <!-- The shipped Launcher exe (release assets cc-launcher-win-x64.exe / cc-launcher-mac-arm64). -->
    <AssemblyName>cc-launcher</AssemblyName>
    <RootNamespace>CcDirector.Launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The registration-directory scan is the seam a test has to reach: it is a pure function of the storage
       layout, and the defect it fixes was entirely about WHICH directories get looked in. Exposing it through
       the public surface would put an implementation detail on the supervisor's contract, so the test assembly
       is admitted to internals instead. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CcDirector.Launcher.Tests" />
  </ItemGroup>

  <!-- Windows-only executable dressing: the Win32 icon resource and the app manifest
       only apply to the Windows apphost. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.*" />
  </ItemGroup>

  <!-- NO Microsoft.AspNetCore.App framework reference, ON PURPOSE (remove-the-network-port mission,
       phase 6). The launcher listens on nothing: its web host is deleted, and this project must not
       reference the hosting/Kestrel surface at all - the listener guard test asserts exactly that, at
       project and assembly level, because a dependency cannot be hidden the way source text can.
       The SignalR CLIENT package below is not an exception to that rule: it is the capability to
       CONNECT OUT (dialing the Gateway's LauncherHub to receive lifecycle commands down the stream),
       not the capability to LISTEN, and connecting out is the entire architecture this mission moved
       the launcher to. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CcDirector.Core\CcDirector.Core.csproj" />
    <!-- Issue #331: LauncherRegistrationRequest lives in Gateway.Contracts. -->
    <ProjectReference Include="..\CcDirector.Gateway.Contracts\CcDirector.Gateway.Contracts.csproj" />
    <ProjectReference Include="..\..\tools\cc-director-setup-engine\CcDirector.Setup.Engine.csproj" />
    <!-- Shared OneDrive-style tray flyout (replaces the legacy right-click menu). -->
    <ProjectReference Include="..\CcDirector.TrayUi\CcDirector.TrayUi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\tray.ico" />
    <AvaloniaResource Include="Assets\icon.png" />
  </ItemGroup>

</Project>
