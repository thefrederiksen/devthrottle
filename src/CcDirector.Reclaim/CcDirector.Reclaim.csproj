<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CcDirector.Reclaim.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core is referenced for two things only: FileLog, which CLAUDE.md rule 2 requires on every
         public method, and CcStorage, which owns every path the product writes. Nothing here uses
         anything else from it, and nothing here is platform specific - the Windows rules arrive in
         phase 2 as a separate project. -->
    <ProjectReference Include="..\CcDirector.Core\CcDirector.Core.csproj" />
  </ItemGroup>

</Project>
