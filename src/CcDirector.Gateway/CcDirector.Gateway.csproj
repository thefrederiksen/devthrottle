<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The shipped Gateway exe name (devthrottle-gateway) belongs to the TRAY app
         (CcDirector.GatewayApp). This project is the gateway library + dev console host. -->
    <AssemblyName>CcDirector.Gateway</AssemblyName>
    <!-- Framework-dependent always, so the tray app (also framework-dependent) can publish
         single-file while referencing this project (NETSDK1151 otherwise). -->
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>CcDirector.Gateway</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Gateway Cleanup mission: the SignalR MessagePack protocol for the DirectorHub (the tunnel). NOT in
         the shared framework, so it is referenced explicitly. Binary framing keeps a 48KB byte[] up-stream
         frame ~48KB on the wire (not ~64KB base64 under JSON), so the MaxBinaryFrameBytes+envelope receive
         limit is correct and there is no 33% base64 tax on every tunnel byte. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.9" />
    <!-- Server-side QR generation for the phone-pairing QR (issue #385). PngByteQRCode renders
         PNG bytes with no System.Drawing dependency, so it works cross-platform / headless. -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- Cron parsing + DST-correct next-occurrence for the cron-jobs feature (epic #479, #482).
         Cronos is a pure parser/calculator (no scheduler/threading model), UTC-first and used by
         Hangfire - it slots into the Gateway's own hosted loop without fighting it. -->
    <PackageReference Include="Cronos" Version="0.8.4" />
    <!-- Issue #806 (mobile foundation): emit an OpenAPI document the mobile app's codegen
         (openapi-typescript) consumes. Pinned to the installed ASP.NET Core runtime (10.0.9) so
         there is no framework/package version skew under TreatWarningsAsErrors. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- Direct reference ONLY to lift the transitive Microsoft.OpenApi 2.0.0 that
         Microsoft.AspNetCore.OpenApi 10.0.9 pulls in: 2.0.0 carries the high-severity advisory
         GHSA-v5pm-xwqc-g5wc (circular schema references can terminate OpenAPI parsing), which
         fails restore under TreatWarningsAsErrors (NU1903). 2.7.5 is the first patched version. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Web Push (VAPID signing + RFC 8291 message encryption) for the mobile app-icon "needs you"
         dot. On net5+ it uses built-in .NET crypto (no BouncyCastle); its only transitive dependency
         is Lib.Net.Http.EncryptedContentEncoding. -->
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <!-- Mission "SQLite on the Gateway": the Gateway statistics database (gateway-stats.db). Core already
         references this package and the Gateway references Core, so this reference is not what makes the
         type resolve - it is here because the Gateway now uses SQLite DIRECTLY, and a project that depends
         on a package states so rather than leaning on a transitive reference that Core is free to drop.
         Version-matched to Core's (9.0.2) so there is no package downgrade under TreatWarningsAsErrors. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.2" />
    <!-- Hosted Gateway mission, Step 1b: the EF Core data-access backbone. One data model runs on
         SQLite locally and (later) Postgres in the cloud, with real migrations, instead of hand-rolled
         JSON stores. Pinned to 9.0.2 so the Microsoft.Data.Sqlite the EF Sqlite provider brings matches
         the 9.0.2 already referenced above - one Microsoft.Data.Sqlite in the process, no version skew.
         The .Design package is the migration tooling. SQLitePCLRaw stays pinned to the patched 3.0.3 via
         Core (advisory GHSA-2m69-gcr7-jv3q), which wins transitively over EF's 2.1.11. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.2" />
    <!-- Hosted Gateway mission, Step 4a: the PostgreSQL provider for the SAME EF Core data model. The local
         install stays on SQLite; a hosted single-tenant Gateway runs on Postgres when CC_GATEWAY_DB_CONNECTION
         is set. Pinned to 9.0.2 so the Npgsql provider's EF Core dependency matches the 9.0.2 already
         referenced above - one EF Core version in the process, no downgrade under TreatWarningsAsErrors. A
         10.x Npgsql would drag EF Core to 10 and break that pin, so it is deliberately held at 9.0.2. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CcDirector.Gateway.Contracts\CcDirector.Gateway.Contracts.csproj" />
    <ProjectReference Include="..\CcDirector.Core\CcDirector.Core.csproj" />
    <!-- The Gateway's in-process warm brain (issues #184/#185): BrainSupervisor + HostedAgent
         power the turn-brief stamping machine. -->
    <ProjectReference Include="..\CcDirector.HostedAgent\CcDirector.HostedAgent.csproj" />
    <!-- Setup engine: install-layout paths + the Tailscale front-door helper the Gateway shares. -->
    <ProjectReference Include="..\..\tools\cc-director-setup-engine\CcDirector.Setup.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CcDirector.Gateway.Tests" />
    <!-- The unlocked half of the same suite (the pure tests, split out so they no longer queue
         behind the machine-wide Gateway test lock). Same tests, same access, one assembly over. -->
    <InternalsVisibleTo Include="CcDirector.Gateway.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Gateway serves NO UI (one-URL plan: docs/plans/one-url-cockpit.md). Every page
         lives in the Cockpit; only the token login page remains here. -->
    <EmbeddedResource Include="Web\login.html" />
    <!-- The instruction bodies the built-in workflows ship with (Workflows mission). Kept as .md
         files, not C# string literals, so the mission conduct stays diffable against its source
         (.claude/skills/mission/SKILL.md) and cannot drift through escaping. -->
    <EmbeddedResource Include="Workflows\Content\*.instructions.md" />
    <!-- The bodies the built-in skills ship with (the central skill library). Kept as .md files, not
         C# string literals, so they stay diffable against the skill files they came from and cannot
         drift through escaping. -->
    <EmbeddedResource Include="Skills\Content\*.skill.md" />
    <!-- The mentor's skill and rubric (Mentor on the Gateway, Phase B): the agent loop's system prompt, copied
         VERBATIM from the internal repository at the commit named on each file's first line. Kept as .md files
         so they stay diffable against their source and cannot drift through escaping. -->
    <EmbeddedResource Include="Mentor\Skill\SKILL.md" LogicalName="CcDirector.Gateway.Mentor.Skill.SKILL.md" />
    <EmbeddedResource Include="Mentor\Skillubric.md" LogicalName="CcDirector.Gateway.Mentor.Skill.rubric.md" />
  </ItemGroup>

  <!-- ============================================================================
       Issue #806 (mobile foundation): build the React PWA and stage it under wwwroot/mobile.

       BUILD-TIME ONLY and RELEASE-ONLY. Node.js + npm are needed only to compile the React
       sources to static files, and only on the machine that builds the release. The target is
       gated to a publish/release configuration (or an explicit -p:BuildMobile=true), so a
       routine `dotnet build` (Debug) does NOT invoke npm and ordinary C# developers need no
       Node. Machines that only RUN the Gateway need nothing extra - the built files ship in
       the release and the Gateway serves them as static files.

       The freshly built dist/** is copied into wwwroot/mobile and added to Content INSIDE the target
       (BeforeTargets="AssignTargetPaths"), so it flows to this project's output - and, since
       content flows transitively, into the GatewayApp tray exe that references this project.
       ============================================================================ -->
  <PropertyGroup>
    <!-- Issue #968: the front-end is now an npm workspace at the repo root. The mobile app moved to
         apps/mobile and its shared logic to packages/client-core, so dependencies install once at the
         workspace root and the app builds through the workspace (Vite pulls client-core from source). -->
    <WorkspaceRoot>$(MSBuildProjectDirectory)\..\..\</WorkspaceRoot>
    <MobileDir>$(MSBuildProjectDirectory)\..\..\apps\mobile\</MobileDir>
    <MobileWwwroot>$(MSBuildProjectDirectory)\wwwroot\mobile</MobileWwwroot>
    <!-- Run the web build for a publish/release configuration, or on explicit opt-in. -->
    <RunMobileBuild Condition="'$(RunMobileBuild)' == '' and ('$(Configuration)' == 'Release' or '$(BuildMobile)' == 'true')">true</RunMobileBuild>
    <RunMobileBuild Condition="'$(RunMobileBuild)' == ''">false</RunMobileBuild>

    <!-- Epic #967: the React desktop Cockpit is the second workspace shell (apps/cockpit), served by
         the Gateway at /c beside the mobile app at /mobile. It builds through the same workspace and is
         staged into wwwroot/c under the same RELEASE-ONLY gate as the mobile app. -->
    <CockpitDir>$(MSBuildProjectDirectory)\..\..\apps\cockpit\</CockpitDir>
    <CockpitWwwroot>$(MSBuildProjectDirectory)\wwwroot\c</CockpitWwwroot>
    <RunCockpitBuild Condition="'$(RunCockpitBuild)' == '' and ('$(Configuration)' == 'Release' or '$(BuildCockpit)' == 'true')">true</RunCockpitBuild>
    <RunCockpitBuild Condition="'$(RunCockpitBuild)' == ''">false</RunCockpitBuild>

    <!-- Issue #1578: the strict workspace typecheck runs on EVERY configuration, not just Release.
         It used to live inside BuildCockpitApp, which is release-only, so a Debug `dotnet build` -
         what everyone actually runs locally - never type-checked the TypeScript. CI builds Release,
         so a type error passed locally and failed on main: main was red for five straight commits
         behind exactly that gap (#1573). Typechecking is fast (~25s cold, and incremental after);
         bundling the app is slow. They were fused for no reason, so they are split here. -->
    <RunWorkspaceTypecheck Condition="'$(RunWorkspaceTypecheck)' == ''">true</RunWorkspaceTypecheck>
    <!-- BaseIntermediateOutputPath ("obj\"), NOT IntermediateOutputPath: the latter is set by the
         SDK's bottom .targets import, so it is still EMPTY here and the stamp would land in the
         project directory as an untracked junk file. obj\ is gitignored. The stamp is deliberately
         not per-configuration - tsc does not care about Debug vs Release, so a Debug build having
         checked these exact inputs is a real answer for Release too. -->
    <WorkspaceTypecheckStamp>$(BaseIntermediateOutputPath)workspace-typecheck.stamp</WorkspaceTypecheckStamp>
  </PropertyGroup>

  <!-- What the typecheck reads. If a file tsc looks at is not listed here, the stamp goes stale and
       the gate reports a false green - so this must cover the sources, the tsconfigs and the
       manifests (a dependency or script change alters the result too). node_modules is excluded:
       it is enormous, and npm ci rewrites package-lock.json, which IS listed. -->
  <ItemGroup>
    <WorkspaceTypecheckInput Include="$(WorkspaceRoot)packages\**\*.ts;$(WorkspaceRoot)packages\**\*.tsx"
                             Exclude="$(WorkspaceRoot)packages\**\node_modules\**;$(WorkspaceRoot)packages\**\dist\**" />
    <WorkspaceTypecheckInput Include="$(WorkspaceRoot)apps\**\*.ts;$(WorkspaceRoot)apps\**\*.tsx"
                             Exclude="$(WorkspaceRoot)apps\**\node_modules\**;$(WorkspaceRoot)apps\**\dist\**" />
    <WorkspaceTypecheckInput Include="$(WorkspaceRoot)packages\**\tsconfig*.json;$(WorkspaceRoot)apps\**\tsconfig*.json"
                             Exclude="$(WorkspaceRoot)packages\**\node_modules\**;$(WorkspaceRoot)apps\**\node_modules\**" />
    <WorkspaceTypecheckInput Include="$(WorkspaceRoot)packages\**\package.json;$(WorkspaceRoot)apps\**\package.json"
                             Exclude="$(WorkspaceRoot)packages\**\node_modules\**;$(WorkspaceRoot)apps\**\node_modules\**" />
    <WorkspaceTypecheckInput Include="$(WorkspaceRoot)package.json;$(WorkspaceRoot)package-lock.json;$(WorkspaceRoot)tsconfig*.json" />
  </ItemGroup>

  <Target Name="BuildMobileApp" BeforeTargets="AssignTargetPaths" Condition="'$(RunMobileBuild)' == 'true'">
    <Message Importance="high" Text="[BuildMobileApp] building the mobile PWA ($(Configuration)) from $(MobileDir) via the workspace at $(WorkspaceRoot)" />
    <Exec Command="npm ci" WorkingDirectory="$(WorkspaceRoot)" />
    <Exec Command="npm run build --workspace @devthrottle/mobile" WorkingDirectory="$(WorkspaceRoot)" />
    <RemoveDir Directories="$(MobileWwwroot)" />
    <ItemGroup>
      <_MobileDistFiles Include="$(MobileDir)dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_MobileDistFiles)"
          DestinationFiles="@(_MobileDistFiles->'$(MobileWwwroot)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Message Importance="high" Text="[BuildMobileApp] staged @(_MobileDistFiles->Count()) file(s) into $(MobileWwwroot)" />
    <ItemGroup>
      <Content Include="wwwroot\mobile\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- ============================================================================
       Epic #967: build the React desktop Cockpit (apps/cockpit) and stage it under wwwroot/c.

       Same shape and gating as BuildMobileApp above: BUILD-TIME ONLY and RELEASE-ONLY. A routine
       `dotnet build` (Debug) does NOT invoke npm; the built static files ship in the release and the
       Gateway serves them at /c. The freshly built dist/** is copied into wwwroot/c and added to
       Content INSIDE the target so it flows to this project's output (and transitively to the tray
       exe that references this project).
       ============================================================================ -->
  <!-- ============================================================================
       Issue #1578: the strict, test-inclusive workspace typecheck, as its own build gate.

       Issue #1010 added this because the workspace build (vite / esbuild) does not type-check and
       the per-package declaration build (tsconfig.build.json) excludes test files, so a strictly-
       typed test file could regress unnoticed. But it was placed INSIDE BuildCockpitApp, which is
       release-only - so the Debug build everyone runs locally never type-checked anything, and the
       error surfaced only on CI (which builds Release). #1573 is what that costs: main red for five
       commits over three object literals missing a cast.

       It runs for every configuration now. Inputs/Outputs make it incremental: touch no TypeScript
       and MSBuild skips the target outright, so a C# developer pays nothing after the first build.
       Set -p:RunWorkspaceTypecheck=false to skip it deliberately (a machine with no Node.js, say);
       that is an explicit choice, not a silent one.
       ============================================================================ -->
  <Target Name="TypecheckWorkspaces"
          BeforeTargets="AssignTargetPaths"
          Condition="'$(RunWorkspaceTypecheck)' == 'true'"
          Inputs="@(WorkspaceTypecheckInput)"
          Outputs="$(WorkspaceTypecheckStamp)">
    <Error Condition="!Exists('$(WorkspaceRoot)package.json')"
           Text="The npm workspace root was not found at $(WorkspaceRoot). The Gateway serves the Cockpit and mobile app from it, so this path must be right." />

    <!-- No node_modules means tsc is not on the path and the typecheck would report a false green.
         Install once, here, rather than skipping the gate. -->
    <Message Importance="high" Condition="!Exists('$(WorkspaceRoot)node_modules')"
             Text="[TypecheckWorkspaces] node_modules is missing - running npm ci once (this takes a minute; later builds reuse it)" />
    <Exec Command="npm ci" WorkingDirectory="$(WorkspaceRoot)" Condition="!Exists('$(WorkspaceRoot)node_modules')" />

    <Message Importance="high" Text="[TypecheckWorkspaces] strict test-inclusive typecheck across every workspace ($(Configuration))" />
    <Exec Command="npm run typecheck --workspaces --if-present" WorkingDirectory="$(WorkspaceRoot)" />

    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <Touch Files="$(WorkspaceTypecheckStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="BuildCockpitApp" BeforeTargets="AssignTargetPaths" DependsOnTargets="TypecheckWorkspaces" Condition="'$(RunCockpitBuild)' == 'true'">
    <Message Importance="high" Text="[BuildCockpitApp] building the React Cockpit ($(Configuration)) from $(CockpitDir) via the workspace at $(WorkspaceRoot)" />
    <Exec Command="npm ci" WorkingDirectory="$(WorkspaceRoot)" />
    <!-- The typecheck that used to live here is now the TypecheckWorkspaces gate above, which this
         target depends on so the release path still type-checks before it bundles. -->
    <Exec Command="npm run build --workspace @devthrottle/cockpit" WorkingDirectory="$(WorkspaceRoot)" />
    <RemoveDir Directories="$(CockpitWwwroot)" />
    <ItemGroup>
      <_CockpitDistFiles Include="$(CockpitDir)dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CockpitDistFiles)"
          DestinationFiles="@(_CockpitDistFiles->'$(CockpitWwwroot)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Message Importance="high" Text="[BuildCockpitApp] staged @(_CockpitDistFiles->Count()) file(s) into $(CockpitWwwroot)" />
    <ItemGroup>
      <Content Include="wwwroot\c\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Keep the generated wwwroot out of source control via the project-local .gitignore. -->

</Project>
