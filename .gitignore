# Claude Code sound cache wherever it lands (e.g. when scripts run from
# a subdirectory and Claude auto-creates a .claude/sounds/ there).
**/.claude/sounds/

# .NET test result artifacts (.trx, coverage XML)
**/TestResults/

# Per-session scratch test screenshots / workflow artifacts. JetBrains Rider
# also uses .run/ for shared run configs - add a positive override here if
# someone wants to check those in.
.run/
**/.run/
supabase-credentials.txt
docs/MACHINE_AUDIT_*.md
code-review-log.json
tmp_build_output/after_click.png
tmp_build_output/dialog_check.png
tmp_build_output/reconnect-result.png
tmp_build_output/reconnect-test.png
tmp_build_output/restarted.png
tmp_build_output/right_click_session.png

.temp/

# Root-level per-session scratch artifacts: screenshots, mockups, diagnostic
# dumps. Keeps `tmp_*.png/html/txt` from accumulating in `git status`.
/tmp_*

# cc-browser native-host bridge: native-host.bat is generated locally by setup
# with machine-specific paths, so it must not be tracked. (com.cc_browser.bridge.json
# stays tracked as a PLACEHOLDER template; setup fills it in locally -- revert it
# if it shows as modified.)
/tools/cc-browser/native-host/native-host.bat

# Data output files
tools/cc-gmail/sent_contacts.json

# Screenshots with potential PII
screenshot-*.png
docs/simple-chat-plain-text-table.png

# Debug/temp output files
cli-explorer-console*.txt
cli-explorer-report.md
json-schema-stderr.txt
outlook-stderr.txt
*_wpftmp.csproj

# Data backup files
docs/deleted-*-contacts-backup.json

# Node
node_modules/

# Python
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
venv/
.venv/
*.egg
.Python

# IDE
.idea/
*.swp
*.swo
.DS_Store

# Lock files (tool-specific)
tools/cc-fox-browser/package-lock.json

# Terminal test screenshots (may contain PII)
playground/terminal-test/*.png

# Raw view harness generated output (HTML fixtures + screenshots; regenerable)
playground/raw-view-harness/out/

# Playwright CLI session artifacts
.playwright-cli/

# Browser automation snapshots
.cc-browser/

# Verify-run build output (dotnet build -o obj_verify/out; regenerable)
obj_verify/

# Verify-build output folders (regenerable; sometimes name-mangled by sync)
bin-verify*/

# Scratch/sandbox folders
.tmp-*/

# Voice-mode-fidelity test evidence: raw voice recordings and transcripts that
# can contain real names and personal speech. Keep the REPORT.md/.html (clean
# summary) but never commit the evidence captures to this public repo.
docs/features/voice-mode-fidelity/evidence/

# Cockpit prototype + playground screenshots (throwaway / PII-bearing; not for the public repo)
playground/wingman-briefing/
playground/*.png

# Merge/patch backup files
*.orig

# Headless-brain / hosted-agent harness runtime artifacts (issue #172 family):
# generated sandbox working dirs, harness state, smoke run output, isolated-config
# test roots. Live sessions write here; never commit.
playground/headless-brain/sandbox*/
playground/headless-brain/state.json
playground/hosted-agent-smoke/sandboxes/
playground/hosted-agent-smoke/smoke-output.txt
playground/alpha-test-root/

# MCP server tool-definition schema dumps, written into the repo root at runtime by
# connected MCP tooling (acmeflow-dev-proto / acmeflow-localhost-proto / pencil). Generated
# local artifacts, never part of the codebase.
mcps/

# Mobile terminal render debugging scratch (not shipped): the standalone repro harness and
# the captured real pseudo-terminal stream fixtures it feeds. Regenerable from a live session;
# the binary fixtures do not belong in git history.
mobile/repro-terminal.*
mobile/public/fixtures/

# Terminal-injection flake-test proof output (issue #1119 QA runs) and any other
# ad-hoc test-run scratch written to the repo root. Regenerable from a live session;
# thousands of per-run capture files, never part of the codebase.
artifacts/
_inspection/
codex-review-*.md
codex-rereview-*.md
*.received.txt

# Review and mutation scratch. Never committed: a reviewer MUTATES the working tree while it reads,
# so anything swept up from here can be a live mutant rather than a change somebody made.
.review/
