<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DrainIndexDiff</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The REAL drain, not a copy of it. This harness seeds a test Director from the hand-written index
         and then runs CcDirector.ControlApi.Drain.DirectorDrain over it, because a harness that
         reimplemented the drain would be comparing the hand-written index against itself. -->
    <ProjectReference Include="..\..\..\src\CcDirector.ControlApi\CcDirector.ControlApi.csproj" />
  </ItemGroup>

</Project>
