<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CcDirectorSetup.Steps.CompleteStep">
    <DockPanel>
        <!-- Setup details & log: a small collapsed expander on success; auto-expanded and
             emphasized when components were skipped/failed. -->
        <Expander x:Name="DetailsExpander"
                  DockPanel.Dock="Bottom"
                  Margin="0,16,0,0"
                  IsExpanded="False">
            <Expander.Header>
                <TextBlock x:Name="DetailsHeader"
                           Text="Setup details &amp; log"
                           Foreground="#888888"
                           FontSize="12" />
            </Expander.Header>
            <Border Background="#2A2D2E" CornerRadius="6" Padding="16" Margin="0,8,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Install path:"
                                   Foreground="#888888" FontSize="12" />
                        <TextBlock x:Name="PathText"
                                   Grid.Column="1"
                                   Foreground="#AAAAAA" FontSize="12"
                                   TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="The full setup log is saved here:"
                               Foreground="#888888" FontSize="12" Margin="0,0,0,4" />
                    <TextBox x:Name="LogPathBox" IsReadOnly="True" FontSize="11"
                             Background="#1E1E1E" Foreground="#AAAAAA" BorderThickness="0"
                             TextWrapping="Wrap" Padding="6" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="OpenLogButton" Classes="setup" Content="Open log folder" Padding="10,4"
                                Margin="0,0,8,0" Click="OpenLogButton_Click" />
                        <Button x:Name="ReportButton" Classes="setup" Content="Report a problem on GitHub" Padding="10,4"
                                Click="ReportButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ReportHint"
                               Text="Opens a pre-filled GitHub issue (review and click Submit). Please attach the log file above."
                               Foreground="#666666" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Expander>

        <!-- The main column scrolls: with the details expander docked at the bottom, a tall
             failure/notice stack would otherwise overflow INTO the expander and paint over it. -->
        <ScrollViewer>
        <StackPanel>
            <TextBlock x:Name="HeadingText"
                       Text="&#x2713;  Director is installed"
                       Foreground="#22C55E"
                       FontSize="22"
                       FontWeight="SemiBold" />

            <TextBlock x:Name="DescriptionText"
                       Text="You're ready to go."
                       Foreground="#CCCCCC"
                       FontSize="13"
                       Margin="0,12,0,24"
                       LineHeight="20" />

            <!-- Launch button: the hero of the happy path. Colours + hover/pressed live in the
                 Button.launch style (Styles.axaml) so the green stays visible on hover. -->
            <Button x:Name="LaunchButton"
                    Classes="launch"
                    Height="44"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,12"
                    FontSize="16"
                    FontWeight="SemiBold"
                    HorizontalContentAlignment="Center"
                    Content="Open Director"
                    Click="LaunchButton_Click" />

            <!-- A WARNING: something that did not install without failing the install (the launcher,
                 which only adds autostart). The install finished and the Director opens; this says what
                 the person loses and what happens next. Never rendered as "finished with problems". -->
            <Border x:Name="WarningPanel" Background="#2A2D2E" BorderBrush="#E0A030" BorderThickness="1"
                    CornerRadius="6" Padding="12" Margin="0,0,0,12" IsVisible="False">
                <StackPanel>
                    <TextBlock x:Name="WarningHeader"
                               Text="One thing to know"
                               Foreground="#E0A030"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <TextBlock x:Name="WarningText"
                               Foreground="#CCCCCC"
                               FontSize="12"
                               TextWrapping="Wrap"
                               LineHeight="18" />
                </StackPanel>
            </Border>

            <!-- One quiet summary line on success -->
            <TextBlock x:Name="SummaryLine"
                       Foreground="#888888"
                       FontSize="13"
                       Margin="0,0,0,12" />

            <!-- Full summary box: only shown when something was skipped/failed -->
            <Border x:Name="FailurePanel" Background="#2A2D2E" CornerRadius="6" Padding="16"
                    Margin="0,0,0,12" IsVisible="False">
                <StackPanel>
                    <TextBlock Text="Summary"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Installed:"
                                   Foreground="#888888" FontSize="13" />
                        <TextBlock x:Name="InstalledText"
                                   Grid.Column="1"
                                   Foreground="#22C55E" FontSize="13" FontWeight="SemiBold" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Skipped / failed:"
                                   Foreground="#888888" FontSize="13" />
                        <TextBlock x:Name="SkippedText"
                                   Grid.Column="1"
                                   Foreground="#E0A030" FontSize="13" FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Note about terminal PATH -->
            <!-- The one thing said about the MACHINE rather than about this install: there is no
                 coding agent on it, so the board has nothing to run. MainWindow computes the
                 wording from AgentPresence; this screen only renders it. -->
            <Border x:Name="CapabilityPanel" Background="#2A2D2E" CornerRadius="6" Padding="12"
                    Margin="0,0,0,12" IsVisible="False">
                <TextBlock x:Name="CapabilityNoticeText"
                           Foreground="#E0A030"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <TextBlock x:Name="PathNote"
                       Text="If you use a terminal: open a new one before running the cc-* commands. Terminals that are already open will not find them yet."
                       Foreground="#666666"
                       FontSize="11"
                       TextWrapping="Wrap" />
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
