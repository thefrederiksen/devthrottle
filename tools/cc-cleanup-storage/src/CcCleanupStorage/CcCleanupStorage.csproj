<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>cc-cleanup-storage</AssemblyName>
    <RootNamespace>CcCleanupStorage</RootNamespace>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\CcDirector.Reclaim\CcDirector.Reclaim.csproj" />
    <!-- The Windows rules. The tool builds and runs on every platform: it asks the rule set what
         rules exist here, and on a machine that is not Windows the answer is none, said plainly. -->
    <ProjectReference Include="..\..\..\..\src\CcDirector.Reclaim.Windows\CcDirector.Reclaim.Windows.csproj" />
  </ItemGroup>

</Project>
