{
  "name": "@devthrottle/client-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared TypeScript client library for the DevThrottle browser shells (the mobile PWA and the React Cockpit). The typed Gateway client, history rendering, the xterm byte-stream engine, dictation, device auth, and session ordering all live here so both shells depend on exactly one copy. It talks only to the Gateway through root-relative URLs.",
  "exports": {
    "./auth/SignIn": "./src/auth/SignIn.tsx",
    "./auth/DeviceCallback": "./src/auth/DeviceCallback.tsx",
    "./auth/AccountsPanel": "./src/auth/AccountsPanel.tsx",
    "./auth/AccountSwitcher": "./src/auth/AccountSwitcher.tsx",
    "./dictation/DictationDialog": "./src/dictation/DictationDialog.tsx",
    "./dictation/DictationStatusStrip": "./src/dictation/DictationStatusStrip.tsx",
    "./dictation/MicTestPanel": "./src/dictation/MicTestPanel.tsx",
    "./dictation/TranscriptionTestPanel": "./src/dictation/TranscriptionTestPanel.tsx",
    "./settings/SettingsTabs": "./src/settings/SettingsTabs.tsx",
    "./settings/NotificationsTab": "./src/settings/NotificationsTab.tsx",
    "./restart/RestartRequestsPanel": "./src/restart/RestartRequestsPanel.tsx",
    "./stats/ThrottleWindowSelector": "./src/stats/ThrottleWindowSelector.tsx",
    "./transcription/MicrophoneQualityPanel": "./src/transcription/MicrophoneQualityPanel.tsx",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "gen:api": "openapi-typescript http://127.0.0.1:7878/openapi/v1.json --output src/api/schema.ts"
  },
  "dependencies": {
    "@xterm/xterm": "5.5.0",
    "marked": "^14.1.4"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
