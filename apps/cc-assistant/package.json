{
  "name": "@devthrottle/cc-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CC Assistant. A voice assistant you talk to, with a wake word each person chooses for themselves.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "node server/wilson.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/check-node-version.mjs && vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "vite": "6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "2.1.8"
  }
}
