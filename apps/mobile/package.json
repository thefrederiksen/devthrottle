{
  "name": "@devthrottle/mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DevThrottle mobile Progressive Web App, served by the Gateway at /mobile. A thin shell over @devthrottle/client-core.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/check-node-version.mjs && vitest run"
  },
  "dependencies": {
    "@devthrottle/client-core": "*",
    "@xterm/xterm": "5.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "vite": "6.0.3",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
