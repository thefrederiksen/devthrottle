<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in Director for the Handle the issue QA rig (docs/qa/factory-control/handle-the-issue). It dials the rig
       Gateway's Director stream like a real Director, answers a session create, and writes down exactly what the
       Gateway sent. It never starts a real session. Not part of the solution and not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\..\src\CcDirector.Gateway.Contracts\CcDirector.Gateway.Contracts.csproj" />
  </ItemGroup>

</Project>
